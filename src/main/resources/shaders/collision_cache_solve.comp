#version 430 core
layout(local_size_x = 256) in;
#include "collision_cache_layout.glsl"
layout(std430, binding = 0) readonly buffer InputBodies { vec4 inputBodies[]; };
layout(std430, binding = 1) writeonly buffer OutputBodies { vec4 outputBodies[]; };
layout(std430, binding = 2) readonly buffer Heads { uint heads[]; };
layout(std430, binding = 3) readonly buffer Nodes { GridNode nodes[]; };
layout(std430, binding = 4) readonly buffer ContactCounts { uint contactCounts[]; };
layout(std430, binding = 5) writeonly buffer Pressures { float pressures[]; };
layout(std430, binding = 6) buffer AdaptiveState { uint adaptiveState[]; };
layout(std430, binding = 7) buffer Cache { uint cache[]; };
#ifdef RIGID
layout(std430, binding = 11) readonly buffer Pool { uint pool[]; };
layout(std430, binding = 12) readonly buffer GhostHeads { uint ghostHeads[]; };
#endif
uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform int uSearchRadius;
uniform int uNeighborCellRadius;
uniform vec2 uViewport;
uniform float uDiameterPixels;
uniform int uDenseContactThreshold;
uniform int uDenseSampleThreshold;
uniform float uRestitutionCoefficient;
uniform float uCoincidentDistanceSquaredEpsilon;
uniform float uSubstepDt;
uniform float uTimeStep;
uniform int uWritePressure;
uniform int uAdaptive;
uniform int uSubstepIndex;
uniform int uBounded;
#ifdef RIGID
uniform float uDriftDt;
#endif
// Largest float below 1: a body clamped to a wall stays in the last grid cell.
const float MAXIMUM_UNIT = 0.99999994;
#include "collision_material.glsl"
#include "collision_cache_grid.glsl"
#ifdef RIGID
#include "collision_rigid.glsl"
#include "collision_rigid_contact.glsl"
#include "collision_relief.glsl"
#endif
#include "collision_crowd.glsl"
#define SLEEP_MARK
#include "sleep_layout.glsl"
// Displacement per step (px²) below which a held body rests, and from
// which a body also wakes the tile it is heading to (SleepTiles.kt).
uniform float uSleepDisplacementSquared;
uniform float uSleepTileMarkSquared;
// A wall is an immovable body: the moving body takes the whole correction
// that a pair would split, with the same restitution and position-to-velocity
// conversion as body-body contacts.
void wallContact(uint id, int wall, vec2 positionPixels, float distance, vec2 normal, vec2 velocityPixels,
    float pressureWeight, float friction, float effectiveSubstepDt, inout vec2 positionCorrection,
    inout vec2 velocityCorrection, inout float pressure) {
#ifdef RIGID
    if (isMember(ownMaterial)) {
        rigidWallContact(id, wall, positionPixels, distance, normal, velocityPixels, pressureWeight, friction,
            driftDt, effectiveSubstepDt, velocityCorrection, pressure);
        return;
    }
#endif
    float penetration = 0.5 * uDiameterPixels - distance;
    if (penetration <= 0.0) return;
    float weight = pressureWeight;
    positionCorrection += normal * (penetration * weight);
    float normalSpeed = dot(velocityPixels, normal);
    if (normalSpeed < 0.0) {
        velocityCorrection -= normal *
            ((1.0 + uRestitutionCoefficient) * normalSpeed * weight);
    }
    if (friction > 0.0) {
        // The wall has the body's own friction coefficient.
        velocityCorrection += frictionCorrection(velocityPixels, normal, normalSpeed,
            weight * ((1.0 + uRestitutionCoefficient) * max(-normalSpeed, 0.0) +
                penetration / effectiveSubstepDt),
            weight, friction);
    }
    if (uWritePressure != 0) {
        pressure += pressureWeight * (
            penetration / effectiveSubstepDt + max(-normalSpeed, 0.0)
        );
    }
}

void wallContacts(uint id, vec2 positionPixels, vec2 velocityPixels, uint ownContacts,
    float friction, float effectiveSubstepDt, inout vec2 positionCorrection,
    inout vec2 velocityCorrection, inout float pressure) {
    if (uBounded == 0) return;
    // Counted as one more contact so body pairs keep their symmetric weights.
    // A member of a block meets the wall as its block (rigidWallContact).
    float weight = 1.0 / float(ownContacts + 1u);
    wallContact(id, 0, positionPixels, positionPixels.x, vec2(1.0, 0.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
    wallContact(id, 1, positionPixels, uViewport.x - positionPixels.x, vec2(-1.0, 0.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
    wallContact(id, 2, positionPixels, positionPixels.y, vec2(0.0, 1.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
    wallContact(id, 3, positionPixels, uViewport.y - positionPixels.y, vec2(0.0, -1.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
}

vec2 fallbackNormal(uint first, uint second) {
    uint low = min(first, second);
    uint high = max(first, second);
    uint hash = low * 1664525u + high * 1013904223u;
    float angle = float(hash & 65535u) * (6.28318530718 / 65536.0);
    vec2 normal = vec2(cos(angle), sin(angle));
    return first < second ? normal : -normal;
}

// The raw count of this body, with its HELD_BIT.
uint ownCount = 0u;
// Whether any body sleeps this step (STATE_ASLEEP).
bool anyAsleep = false;
#ifdef RIGID
// Pushes apart from bodies of held pairs (HELD_BIT): position only.
vec2 heldCorrection = vec2(0.0);
// The sampling threshold of this body and the contacts it shares its
// correction among (collision_crowd.glsl); a body solving all has its count.
uint ownKeep = KEEP_ALL;
uint ownKept = 0u;

// This body's block tag and whether it is a ghost of a crowded cell, which
// meets no loose body (collision_cache_layout.glsl).
uint ownTag = 0u;
bool ownGhost = false;

// A loose pair a crowded body leaves out of its sample, or a ghost's, told
// before anything of the other body is read.
bool sampledOut(uint id, uint other, uint otherTag) {
    otherTag = nodeTag(otherTag);
    if (ownGhost && otherTag == 0u) return true;
    return ownKeep != KEEP_ALL && pairKey(id, other) > ownKeep && otherTag == 0u;
}
#endif

void accumulateContact(uint id, uint otherId, vec2 positionPixels, vec2 velocityPixels,
    uint ownContacts, float effectiveSubstepDt, inout vec2 positionCorrection,
    inout vec2 velocityCorrection, inout float pressure) {
    // A sleeping body stays where it is: this side takes the whole correction.
    bool otherSleeps = anyAsleep && !sleepBodyAwake(otherId);
#ifdef RIGID
    partnerSleeps = otherSleeps;
    vec4 otherMaterial = materials[otherId];
    if (!hardPair(ownMaterial, otherMaterial)) return;
    // A crowded body solves the sample of its loose partners alone; its list
    // may hold more (collision_cache_count.comp).
    if (ownKeep != KEEP_ALL && !isMember(otherMaterial) && pairKey(id, otherId) > ownKeep) return;
#else
    if (!hardPair(id, otherId)) return;
#endif
    float diameterSquared = uDiameterPixels * uDiameterPixels;
    vec4 other = inputBodies[otherId];
    precise vec2 delta = positionPixels - other.xy * uViewport;
    // Walls: no minimum image, bodies across an edge never touch.
    if (uBounded == 0) delta -= floor(delta / uViewport + vec2(0.5)) * uViewport;
    precise float distanceSquared = dot(delta, delta);
#ifdef RIGID
    float reachSquared = contactReachSquared(ownMaterial, otherMaterial);
    if (distanceSquared < reachSquared && rigidPair(ownMaterial, otherMaterial)) {
        rigidContact(id, otherId, otherMaterial, positionPixels, velocityPixels, other.xy * uViewport, other.zw * uViewport,
            ownContacts, contactsOf(contactCounts[otherId]), driftDt, effectiveSubstepDt,
            positionCorrection, velocityCorrection, pressure);
        return;
    }
#else
    float reachSquared = contactReachSquared(id, otherId);
#endif
    if (distanceSquared < reachSquared) {
        float distance = sqrt(max(
            distanceSquared,
            uCoincidentDistanceSquaredEpsilon
        ));
        vec2 normal =
            distanceSquared > uCoincidentDistanceSquaredEpsilon
            ? delta / distance
            : fallbackNormal(id, otherId);
        float penetration = uDiameterPixels - distance;
        uint crowd = max(ownContacts, contactsOf(contactCounts[otherId]));
        uint weightContacts = crowd;
#ifdef RIGID
        // A crowded body solves a sample of its loose pairs, each pair in the
        // sample of both its bodies, and shares among those it samples.
        uint otherKeep = cache[cacheOffset(KEEP_PLANE, otherId)];
        if ((ownKeep & otherKeep) != KEEP_ALL) {
            if (pairKey(id, otherId) > min(ownKeep, otherKeep)) return;
            weightContacts = max(ownKept,
                otherKeep != KEEP_ALL ? cache[cacheOffset(KEPT_PLANE, otherId)] : contactsOf(contactCounts[otherId]));
        }
#endif
        float pairWeight = 1.0 / float(max(weightContacts, 1u));

#ifdef RIGID
        vec4 pairOwn = ownMaterial;
        vec4 pairOther = otherMaterial;
#else
        vec4 pairOwn = materials[id];
        vec4 pairOther = materials[otherId];
#endif
        float share = otherSleeps ? 1.0 : massShare(pairOwn, pairOther);

        // Symmetric weights keep every impulse equal and
        // opposite, including crowded multi-body contacts.
        vec2 otherVelocityPixels = other.zw * uViewport;
        vec2 relativeVelocity =
            velocityPixels - otherVelocityPixels;
        float relativeNormalSpeed =
            dot(relativeVelocity, normal);

        vec2 push = normal * (share * penetration * pairWeight);
#ifdef RIGID
        relieve(normal, share, penetration, pairWeight, crowd, float(crowd) / float(weightContacts), relativeVelocity);
        if (heldPair(ownCount, contactCounts[otherId])) heldCorrection += push;
        else
#endif
        positionCorrection += push;
        if (relativeNormalSpeed < 0.0) {
            // e=0: the approaching normal components meet
            // at the pair's centre-of-mass velocity.
            velocityCorrection -= normal *
                (
                    share *
                    (1.0 + uRestitutionCoefficient) *
                    relativeNormalSpeed *
                    pairWeight
                );
        }
        float friction = pairFriction(pairOwn, pairOther);
        if (friction > 0.0) {
            velocityCorrection += frictionCorrection(
                relativeVelocity, normal, relativeNormalSpeed,
                share * pairWeight * (
                    (1.0 + uRestitutionCoefficient) *
                        max(-relativeNormalSpeed, 0.0) +
                    penetration / effectiveSubstepDt
                ),
                share * pairWeight, friction);
        }
        if (uWritePressure != 0) {
            if (uAdaptive != 0) {
                atomicMax(
                    adaptiveState[1],
                    floatBitsToUint(penetration)
                );
            }
            pressure += 0.5 * pairWeight * (
                penetration / effectiveSubstepDt +
                max(-relativeNormalSpeed, 0.0)
            );
        }

    }
}

// Beyond every contact reach (contactReachSquared), in diameters squared.
const float GATHER_REACH_SQUARED = 2.25;

bool withinReach(vec2 positionPixels, vec2 otherPosition) {
    vec2 delta = positionPixels - otherPosition * uViewport;
    if (uBounded == 0) delta -= floor(delta / uViewport + vec2(0.5)) * uViewport;
    return dot(delta, delta) < GATHER_REACH_SQUARED * uDiameterPixels * uDiameterPixels;
}

// This pass's count is complete, so its density samples choose the broad
// phase of the next pass here instead of in a separate one-thread dispatch.
// No other invocation of this dispatch reads these words.
void scheduleNextPass() {
    bool dense = cache[stateOffset(STATE_DENSE_SAMPLES)] >= uint(uDenseSampleThreshold);
    // A direct pass leaves contacts but no reusable candidate list.
    cache[stateOffset(STATE_REBUILD)] = cache[stateOffset(STATE_DIRECT)] != 0u || dense ? 1u : 0u;
    cache[stateOffset(STATE_DIRECT)] = dense ? 1u : 0u;
    cache[stateOffset(STATE_DENSE_SAMPLES)] = 0u;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    if (uAdaptive != 0 && uSubstepIndex >= 0 && uint(uSubstepIndex) >= adaptiveState[2]) return;
    vec4 body = inputBodies[id];
    // A sleeping body stays as it is (sleep_layout.glsl): the pass carries it
    // over to its output as it is, as the buffers alternate.
    // Nobody sleeps this step: no body is checked (STATE_ASLEEP).
    anyAsleep = uSleep != 0 && cache[stateOffset(STATE_ASLEEP)] == uSleepStamp;
    if (anyAsleep && !sleepBodyAwake(id)) {
        outputBodies[id] = body;
        if (id == 0u) scheduleNextPass();
        return;
    }
#ifdef RIGID
    ownMaterial = materials[id];
#endif
    vec2 positionPixels = body.xy * uViewport;
    vec2 velocityPixels = body.zw * uViewport;
    vec2 positionCorrection = vec2(0.0);
    vec2 velocityCorrection = vec2(0.0);
    float pressure = 0.0;
    ownCount = contactCounts[id];
    uint ownContacts = contactsOf(ownCount);
    float effectiveSubstepDt = uAdaptive != 0
        ? uTimeStep / float(max(adaptiveState[2], 1u)) : uSubstepDt;
#ifdef RIGID
    driftDt = uAdaptive != 0 && uDriftDt != 0.0 ? effectiveSubstepDt : uDriftDt;
    ownKeep = cache[cacheOffset(KEEP_PLANE, id)];
    ownKept = ownKeep != KEEP_ALL ? cache[cacheOffset(KEPT_PLANE, id)] : ownContacts;
    uint ownNodeTag = nodes[id].tag;
    ownTag = nodeTag(ownNodeTag);
    ownGhost = ghostNode(ownNodeTag);
    if (ownKeep != KEEP_ALL && isMember(ownMaterial)) memberSample = float(ownKept) / float(SAMPLED_CONTACTS);
#endif
    if (uWritePressure != 0 && uAdaptive != 0) {
        atomicMax(adaptiveState[3], ownContacts);
        if (ownContacts >= uint(uDenseContactThreshold)) atomicAdd(adaptiveState[4], 1u);
    }
    // A body whose contacts its slots do not list walks its candidates or
    // the grid, and gathers those within reach into its slots, a round at a
    // time, in the order of the walk. The contacts are solved in one place:
    // the shader stays small enough to run fast, and the lanes of a crowd
    // solve side by side instead of each waiting at every candidate for any
    // lane meeting a contact there. The empty case runs zero iterations.
#ifdef RIGID
    // Count lists what a crowded body samples (collision_crowd.glsl), the
    // list pass the rest, in the pool what the slots cannot hold.
    uint listLength = cache[cacheOffset(LIST_PLANE, id)];
    bool pooled = listLength != UNLISTED && (listLength & POOLED) != 0u;
    uint poolOffset = pooled ? cache[cacheOffset(POOL_PLANE, id)] : 0u;
    if (pooled) listLength &= ~POOLED;
#else
    uint listLength = ownContacts <= CONTACT_SLOTS ? ownContacts : UNLISTED;
    bool pooled = false;
    uint poolOffset = 0u;
#endif
    bool walking = listLength == UNLISTED;
    uint neighbors = walking ? cache[cacheOffset(0u, id)] : 0u;
    bool listed = neighbors <= NEIGHBOR_SLOTS;
    uint epoch = 0u;
    ivec2 origin = ivec2(0);
    ivec2 size = ivec2(0);
    if (walking && !listed) {
        uint referenceCell = cache[cacheOffset(1u, id)];
        epoch = cache[stateOffset(STATE_GRID_EPOCH)];
        ivec2 home = ivec2(referenceCell % uint(uGridWidth), referenceCell / uint(uGridWidth));
        int radius = neighbors == DIRECT_GRID ? uNeighborCellRadius : uSearchRadius;
        origin = stencilOrigin(home, radius);
        size = stencilSize(radius);
    }
    // A grid built in this pass holds the positions of this pass.
    bool fresh = neighbors == DIRECT_GRID;
    // The cells of the walk: a member also walks the ghosts of crowded cells.
    int cells = size.x * size.y;
#ifdef RIGID
    if (ownTag != 0u) cells *= 2;
#endif
    // The next candidate or cell of the walk, and the body next in that cell.
    int next = 0;
    uint encoded = 0u;
    bool finished = !walking;
    do {
        uint round = walking ? 0u : listLength;
        while (walking && round < CONTACT_SLOTS) {
            uint other;
            vec2 otherPosition;
            if (listed) {
                if (next >= int(neighbors)) {
                    finished = true;
                    break;
                }
                other = cache[cacheOffset(2u + uint(next), id)];
                next++;
#ifdef RIGID
                if (sampledOut(id, other, nodes[other].tag)) continue;
#endif
                otherPosition = inputBodies[other].xy;
            } else {
                if (encoded == 0u) {
                    if (next >= cells) {
                        finished = true;
                        break;
                    }
                    int index = next % (size.x * size.y);
                    ivec2 cell = wrapCell(origin + ivec2(index % size.x, index / size.x));
#ifdef RIGID
                    uint head = next < size.x * size.y ? heads[cell.x + cell.y * uGridWidth] : ghostHeads[cell.x + cell.y * uGridWidth];
#else
                    uint head = heads[cell.x + cell.y * uGridWidth];
#endif
                    next++;
                    encoded = headBody(head, epoch);
                    continue;
                }
                other = encoded - 1u;
                GridNode node = nodes[other];
                encoded = node.next;
                if (other == id) continue;
#ifdef RIGID
                if (sampledOut(id, other, node.tag)) continue;
#endif
                otherPosition = fresh ? node.position : inputBodies[other].xy;
            }
            if (!withinReach(positionPixels, otherPosition)) continue;
            cache[cacheOffset(2u + NEIGHBOR_SLOTS + round, id)] = other;
            round++;
        }
        for (uint i = 0u; i < round; i++) {
#ifdef RIGID
            uint other = pooled ? pool[poolOffset + i] : cache[cacheOffset(2u + NEIGHBOR_SLOTS + i, id)];
#else
            uint other = cache[cacheOffset(2u + NEIGHBOR_SLOTS + i, id)];
#endif
            accumulateContact(id, other, positionPixels, velocityPixels, ownContacts,
                effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
        }
    } while (!finished);
#ifdef RIGID
    float ownFriction = ownMaterial.y;
#else
    float ownFriction = materials[id].y;
#endif
    wallContacts(id, positionPixels, velocityPixels, ownContacts, ownFriction, effectiveSubstepDt,
        positionCorrection, velocityCorrection, pressure);
    // All this pass moved the body by, besides its drift: a body still
    // being pushed apart from what it overlaps is not at rest (sleep below).
    vec2 moved = positionCorrection;
#ifdef RIGID
    vec2 settled = rigidShift + resolveGuards(positionPixels, driftDt);
    positionPixels += settled;
    moved += settled;
#endif
    positionPixels += positionCorrection;
    velocityPixels += velocityCorrection + positionCorrection / effectiveSubstepDt;
#ifdef RIGID
    vec2 relief = heldCorrection + reliefMove(blockNormals);
    positionPixels += relief;
    moved += relief;
#endif
    vec2 position;
#ifdef RIGID
    if (isMember(ownMaterial)) {
        // A member's correction stands for its block's and may be large; the
        // rigid projection reads it as is and places the member itself.
        position = positionPixels / uViewport;
    } else
#endif
    if (uBounded != 0) {
        position = clamp(positionPixels / uViewport, vec2(0.0), vec2(MAXIMUM_UNIT));
    } else {
        positionPixels = mod(positionPixels, uViewport);
        position = positionPixels / uViewport;
    }
    outputBodies[id] = vec4(position, velocityPixels / uViewport);
    if (uWritePressure != 0) {
        // The step's last pass: a body that moved this step, or that nothing
        // holds, keeps its tile awake for the next step (sleep_layout.glsl).
        float radius = 0.5 * uDiameterPixels;
        float slack = 0.05 * uDiameterPixels;
        bool held = ownContacts > 0u || uBounded != 0 && (
            any(lessThan(positionPixels, vec2(radius + slack))) ||
            any(greaterThan(positionPixels, uViewport - radius - slack)));
#ifdef RIGID
        if (isMember(ownMaterial)) held = groups[groupOf(ownMaterial)].grid.w > 0;
        if (fluidMaterial(ownMaterial)) held = true;
#else
        if (fluidBody(id)) held = true;
#endif
        vec2 displacement = velocityPixels * uTimeStep;
        float settling = 0.005 * uDiameterPixels;
        if (!held || dot(displacement, displacement) >= uSleepDisplacementSquared || dot(moved, moved) > settling * settling) {
            sleepMarkActive(position);
            // A body crossing a tile a step also wakes where it is heading,
            // so what it meets there is awake before it arrives.
            if (dot(displacement, displacement) >= uSleepTileMarkSquared) sleepMarkActive(position + displacement / uViewport);
        }
    }
#ifdef RIGID
    storeFracture(id);
#endif
    // Fluid pressure comes from the liquid passes.
    if (uWritePressure != 0 && !fluidBody(id)) pressures[id] = pressure;
    if (id == 0u) scheduleNextPass();
}
