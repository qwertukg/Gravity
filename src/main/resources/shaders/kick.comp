#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer Accelerations { vec2 acceleration[]; };
layout(std430, binding = 2) readonly buffer ForceX { vec2 forceX[]; };
layout(std430, binding = 3) readonly buffer ForceY { vec2 forceY[]; };
layout(std430, binding = 4) readonly buffer Heads { int heads[]; };
layout(std430, binding = 5) readonly buffer NextBody { int nextBody[]; };
layout(std430, binding = 6) readonly buffer CellCounts { int cellCounts[]; };
layout(std430, binding = 7) readonly buffer CellMasses { uint cellMasses[]; };
layout(std430, binding = 8) readonly buffer Materials { vec4 materials[]; };

uniform int uCount;
uniform int uMeshWidth;
uniform int uMeshHeight;
uniform int uBounded;
// Uniform field switched on with the arrow keys, normalized per screen axis.
uniform vec2 uFieldAcceleration;
// G: 0 when bodies ignore each other's gravity; the uniform field still acts.
uniform int uMutualGravity;
uniform int uPhysicalWidth;
uniform int uPhysicalHeight;
uniform int uInitial;
uniform int uNeighborRadiusX;
uniform int uNeighborRadiusY;
uniform float uDt;
uniform float uGravity;
uniform float uSigmaCells;
uniform float uDomainAspect;
uniform float uTotalMass;
uniform int uExactCellThreshold;
uniform int uMaximumHomeInteractions;
uniform float uMinimumDistanceCellFraction;
const float CELL_MASS_UNITS = 256.0;

ivec2 wrapCell(ivec2 cell) {
    if (cell.x < 0) cell.x += uPhysicalWidth;
    else if (cell.x >= uPhysicalWidth) cell.x -= uPhysicalWidth;
    if (cell.y < 0) cell.y += uPhysicalHeight;
    else if (cell.y >= uPhysicalHeight) cell.y -= uPhysicalHeight;
    return cell;
}

int cellIndex(ivec2 cell) {
    cell = wrapCell(cell);
    return cell.x + cell.y * uPhysicalWidth;
}

ivec2 wrapMesh(ivec2 cell) {
    // Periodic: mesh == physical grid. Walls: cells beyond an edge land in the
    // zero padding of the doubled mesh, so no mass leaks across the walls.
    if (cell.x < 0) cell.x += uMeshWidth;
    else if (cell.x >= uMeshWidth) cell.x -= uMeshWidth;
    if (cell.y < 0) cell.y += uMeshHeight;
    else if (cell.y >= uMeshHeight) cell.y -= uMeshHeight;
    return cell;
}

int forceIndex(ivec2 physicalCell) {
    ivec2 meshCell = wrapMesh(physicalCell);
    return meshCell.x + meshCell.y * uMeshWidth;
}

vec2 localAcceleration(vec2 sourcePosition, vec2 targetPosition, float sourceMass) {
    vec2 deltaNormalized = sourcePosition - targetPosition;
    if (uBounded == 0) deltaNormalized -= floor(deltaNormalized + vec2(0.5));
    vec2 deltaPhysical = deltaNormalized * vec2(uDomainAspect, 1.0);
    float rSquared = dot(deltaPhysical, deltaPhysical);
    float sigma = uSigmaCells / float(uPhysicalHeight);
    float localWeight = exp(-rSquared / (2.0 * sigma * sigma));
    float cellWidth = uDomainAspect / float(uPhysicalWidth);
    float cellHeight = 1.0 / float(uPhysicalHeight);
    float minimumDistance =
        uMinimumDistanceCellFraction * min(cellWidth, cellHeight);
    float physicalScale = uGravity * sourceMass * localWeight /
        (uTotalMass * max(rSquared, minimumDistance * minimumDistance));
    return physicalScale * deltaPhysical / vec2(uDomainAspect, 1.0);
}

vec2 interpolateForce(vec2 position) {
    vec2 gridPosition = position * vec2(uPhysicalWidth, uPhysicalHeight) - 0.5;
    ivec2 base = ivec2(floor(gridPosition));
    vec2 f = fract(gridPosition);
    vec2 v00 = vec2(
        forceX[forceIndex(base)].x,
        forceY[forceIndex(base)].x
    );
    vec2 v10 = vec2(
        forceX[forceIndex(base + ivec2(1, 0))].x,
        forceY[forceIndex(base + ivec2(1, 0))].x
    );
    vec2 v01 = vec2(
        forceX[forceIndex(base + ivec2(0, 1))].x,
        forceY[forceIndex(base + ivec2(0, 1))].x
    );
    vec2 v11 = vec2(
        forceX[forceIndex(base + ivec2(1, 1))].x,
        forceY[forceIndex(base + ivec2(1, 1))].x
    );
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 body = bodies[id];
    if (uMutualGravity == 0) {
        if (uInitial == 0) body.zw += uFieldAcceleration * (0.5 * uDt);
        acceleration[id] = uFieldAcceleration;
        bodies[id] = body;
        return;
    }
    vec2 result = interpolateForce(body.xy) + uFieldAcceleration;
    // P3M Ewald split: the spectral mesh contains the Gaussian-smoothed
    // long-range force. Sparse cells use the exact local complement; dense
    // cells use a Barnes-Hut-style cell monopole to bound frame time.
    ivec2 home = ivec2(floor(body.xy * vec2(uPhysicalWidth, uPhysicalHeight)));
    for (int dy = -uNeighborRadiusY; dy <= uNeighborRadiusY; ++dy) {
        for (int dx = -uNeighborRadiusX; dx <= uNeighborRadiusX; ++dx) {
            ivec2 neighborCell = home + ivec2(dx, dy);
            // Walls: there is nothing beyond an edge to attract.
            if (uBounded != 0 && (any(lessThan(neighborCell, ivec2(0))) ||
                any(greaterThanEqual(neighborCell, ivec2(uPhysicalWidth, uPhysicalHeight))))) continue;
            int index = cellIndex(neighborCell);
            int count = cellCounts[index];
            bool homeCell = dx == 0 && dy == 0;
            if (!homeCell && count > uExactCellThreshold) {
                vec2 center = (vec2(wrapCell(neighborCell)) + 0.5) /
                    vec2(uPhysicalWidth, uPhysicalHeight);
                float aggregateMass = float(cellMasses[index]) / CELL_MASS_UNITS;
                result += localAcceleration(center, body.xy, aggregateMass);
            } else {
                int other = heads[index];
                int visited = 0;
                int limit = homeCell
                    ? uMaximumHomeInteractions
                    : uExactCellThreshold;
                while (other >= 0 && visited < limit) {
                    if (uint(other) != id) {
                        result += localAcceleration(bodies[other].xy, body.xy, materials[other].x);
                    }
                    other = nextBody[other];
                    visited++;
                }
            }
        }
    }

    if (uInitial == 0) body.zw += result * (0.5 * uDt);
    acceleration[id] = result;
    bodies[id] = body;
}
