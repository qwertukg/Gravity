#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Accelerations { vec2 acceleration[]; };

uniform int uCount;
uniform float uDt;

float wrapPosition(float position) {
    return position - floor(position);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 body = bodies[id];
    body.zw += acceleration[id] * (0.5 * uDt);
    body.xy += body.zw * uDt;
    body.x = wrapPosition(body.x);
    body.y = wrapPosition(body.y);
    bodies[id] = body;
}
