#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Accelerations { vec2 acceleration[]; };
layout(std430, binding = 2) buffer ActiveFlags { int activeFlags[]; };

uniform int uCount;
uniform float uDt;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    if (activeFlags[id] == 0) return;
    vec4 body = bodies[id];
    body.zw += acceleration[id] * (0.5 * uDt);
    body.xy += body.zw * uDt;
    if (any(lessThan(body.xy, vec2(0.0))) || any(greaterThanEqual(body.xy, vec2(1.0)))) {
        activeFlags[id] = 0;
        body.zw = vec2(0.0);
    }
    bodies[id] = body;
}
