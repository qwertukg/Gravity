#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Accelerations { vec2 acceleration[]; };
layout(std430, binding = 2) buffer CollisionHeads { int collisionHeads[]; };
layout(std430, binding = 3) buffer NextBody { int nextBody[]; };

uniform int uCount;
uniform float uDt;
uniform int uCollisionWidth;
uniform int uCollisionHeight;
uniform int uBuildCollisionGrid;

void reflectAxis(inout float position, inout float velocity) {
    float phase = mod(position, 2.0);
    if (phase < 0.0) phase += 2.0;
    if (phase >= 1.0) {
        position = 2.0 - phase;
        velocity = -velocity;
    } else {
        position = phase;
    }
    position = min(position, 0.99999994);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 body = bodies[id];
    body.zw += acceleration[id] * (0.5 * uDt);
    body.xy += body.zw * uDt;
    reflectAxis(body.x, body.z);
    reflectAxis(body.y, body.w);
    bodies[id] = body;
    if (uBuildCollisionGrid != 0) {
        ivec2 cell = clamp(
            ivec2(floor(body.xy * vec2(uCollisionWidth, uCollisionHeight))),
            ivec2(0),
            ivec2(uCollisionWidth - 1, uCollisionHeight - 1)
        );
        int index = cell.x + cell.y * uCollisionWidth;
        nextBody[id] = atomicExchange(collisionHeads[index], int(id));
    }
}
