#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer DensitySpectrum { vec2 densitySpectrum[]; };
layout(std430, binding = 1) writeonly buffer ForceXSpectrum { vec2 forceXSpectrum[]; };
layout(std430, binding = 2) writeonly buffer ForceYSpectrum { vec2 forceYSpectrum[]; };
layout(std430, binding = 3) readonly buffer KernelXSpectrum { vec2 kernelXSpectrum[]; };
layout(std430, binding = 4) readonly buffer KernelYSpectrum { vec2 kernelYSpectrum[]; };

uniform int uGridWidth;
uniform int uGridHeight;

const float PI = 3.14159265358979323846;

vec2 multiplyComplex(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

float sinc(float value) {
    return abs(value) < 1e-6 ? 1.0 : sin(value) / value;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint width = uint(uGridWidth);
    uint height = uint(uGridHeight);
    if (id >= width * height) return;

    int rawX = int(id % width);
    int rawY = int(id / width);
    int integerKx = rawX <= uGridWidth / 2 ? rawX : rawX - uGridWidth;
    int integerKy = rawY <= uGridHeight / 2 ? rawY : rawY - uGridHeight;
    float sx = sinc(PI * float(integerKx) / float(uGridWidth));
    float sy = sinc(PI * float(integerKy) / float(uGridHeight));
    float assignmentWindow = sx * sx * sy * sy;
    float deconvolution = 1.0 / max(assignmentWindow * assignmentWindow, 0.08);
    float inverseTransformSize = 1.0 / float(uGridWidth * uGridHeight);
    float scale = deconvolution * inverseTransformSize;

    vec2 rho = densitySpectrum[id];
    forceXSpectrum[id] = multiplyComplex(rho, kernelXSpectrum[id]) * scale;
    forceYSpectrum[id] = multiplyComplex(rho, kernelYSpectrum[id]) * scale;
}
