#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Density { uint density[]; };
layout(std430, binding = 1) buffer Heads { int heads[]; };

uniform int uCells;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(uCells)) return;
    density[i] = 0u;
    heads[i] = -1;
}
