#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Density { uint density[]; };
layout(std430, binding = 1) buffer Heads { int heads[]; };
layout(std430, binding = 2) buffer CellCounts { int cellCounts[]; };

uniform int uMeshCells;
uniform int uParticleCells;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(uMeshCells)) density[i] = 0u;
    if (i < uint(uParticleCells)) {
        heads[i] = -1;
        cellCounts[i] = 0;
    }
}
