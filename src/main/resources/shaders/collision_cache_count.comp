#version 430 core
layout(local_size_x = 256) in;
#include "collision_cache_layout.glsl"
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Heads { uint heads[]; };
layout(std430, binding = 2) readonly buffer Nodes { GridNode nodes[]; };
layout(std430, binding = 3) writeonly buffer ContactCounts { uint contactCounts[]; };
layout(std430, binding = 4) readonly buffer AdaptiveState { uint adaptiveState[]; };
layout(std430, binding = 5) buffer Cache { uint cache[]; };
layout(std430, binding = 6) readonly buffer SolidTiles { uint solidTiles[]; };
#ifdef RIGID
layout(std430, binding = 7) readonly buffer CellTags { uint cellTags[]; };
#endif
uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform int uSearchRadius;
uniform int uNeighborCellRadius;
uniform vec2 uViewport;
uniform float uDiameterPixels;
uniform float uCandidateRadiusSquared;
uniform int uAdaptive;
uniform int uSubstepIndex;
uniform int uBounded;
// Liquid mode without any solid body: no two bodies form a hard pair.
uniform int uNoHardPairs;
#include "collision_cache_grid.glsl"
#include "collision_material.glsl"
#ifdef RIGID
#include "collision_rigid.glsl"
#endif

float pairDistanceSquared(uint id, vec2 position, uint other, vec2 otherPosition) {
    // The reference counter evaluates an unordered pair in ascending ID order
    // and increments BOTH counts. Preserve that orientation here as well:
    // reversing an expression that the driver contracts into an FMA can change
    // its last bit at the strict contact threshold. The own position comes from
    // a register instead of a reload; the operands are the same floats.
    bool ownFirst = id < other;
    vec2 firstPixels = (ownFirst ? position : otherPosition) * uViewport;
    precise vec2 delta = firstPixels - (ownFirst ? otherPosition : position) * uViewport;
    // Walls: no minimum image, bodies across an edge never touch.
    if (uBounded == 0) delta -= floor(delta / uViewport + vec2(0.5)) * uViewport;
    precise float distanceSquared = dot(delta, delta);
    return distanceSquared;
}

// Set once this body touches a block (HELD_BIT).
bool held = false;

void countContact(uint id, uint other, float distanceSquared, inout uint contacts) {
#ifdef RIGID
    vec4 otherMaterial = materials[other];
    if (!hardPair(ownMaterial, otherMaterial)) return;
    if (distanceSquared < contactReachSquared(ownMaterial, otherMaterial)) {
#else
    if (!hardPair(id, other)) return;
    if (distanceSquared < contactReachSquared(id, other)) {
#endif
        if (contacts < CONTACT_SLOTS) cache[cacheOffset(2u + NEIGHBOR_SLOTS + contacts, id)] = other;
        contacts++;
#ifdef RIGID
        // Each body sees the pair: the member of the lower block counts it,
        // or the member when the other is loose.
        int group = groupOf(ownMaterial);
        int otherGroup = groupOf(otherMaterial);
        if (group >= 0 && otherGroup < 0) countLooseContact(group);
        else if (group >= 0 && group < otherGroup) countPartnerContact(group, otherGroup);
        if (group < 0 && otherGroup >= 0) held = true;
#endif
    }
}

#ifdef RIGID
// Whether every body in the stencil of the retained grid is a member of the
// block tagged [tag] (collision_cache_layout.glsl): nothing to count there.
bool ownBlockOnly(ivec2 home, int radius, uint epoch, uint tag) {
    ivec2 origin = stencilOrigin(home, radius);
    ivec2 size = stencilSize(radius);
    for (int y = 0; y < size.y; y++) {
        for (int x = 0; x < size.x; x++) {
            ivec2 cell = wrapCell(origin + ivec2(x, y));
            uint cellTag = cellTags[cell.x + cell.y * uGridWidth];
            if (cellTag >> CELL_TAG_BITS == epoch && (cellTag & CELL_MIXED) != tag) return false;
        }
    }
    return true;
}
#endif

// Whether a solid body may sit in the stencil of the retained grid.
bool solidNear(ivec2 home, int radius, uint epoch) {
    ivec2 origin = stencilOrigin(home, radius);
    ivec2 size = stencilSize(radius);
    int checked = -1;
    for (int y = 0; y < size.y; y++) {
        for (int x = 0; x < size.x; x++) {
            int tile = solidTile(wrapCell(origin + ivec2(x, y)));
            if (tile == checked) continue;
            if (solidTiles[tile] == epoch) return true;
            checked = tile;
        }
    }
    return false;
}

void main() {
    if (uAdaptive != 0 && uSubstepIndex >= 0 && uint(uSubstepIndex) >= adaptiveState[2]) return;
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    bool rebuild = cache[stateOffset(STATE_REBUILD)] != 0u;
    bool direct = cache[stateOffset(STATE_DIRECT)] != 0u;
    // Population and rebuild counter aren't read by any invocation in this
    // dispatch. The flags stay immutable until this pass's solve schedules
    // the next pass (a global barrier separates those passes).
    if (id == 0u && rebuild) {
        cache[stateOffset(STATE_POPULATION)] = uint(uCount);
        cache[stateOffset(STATE_REBUILDS)]++;
    }
    vec2 position = bodies[id].xy;
#ifdef RIGID
    ownMaterial = materials[id];
    uint ownTag = blockTag(ownMaterial);
#endif
    uint neighbors = rebuild ? 0u : cache[cacheOffset(0u, id)];
    uint contacts = 0u;
    if (!rebuild && neighbors <= NEIGHBOR_SLOTS) {
        for (uint i = 0u; i < neighbors; i++) {
            uint other = cache[cacheOffset(2u + i, id)];
            countContact(id, other, pairDistanceSquared(id, position, other, bodies[other].xy), contacts);
        }
    } else {
        uint referenceCell;
        if (rebuild) {
            ivec2 home = clamp(ivec2(floor(position * vec2(uGridWidth, uGridHeight))), ivec2(0), ivec2(uGridWidth - 1, uGridHeight - 1));
            referenceCell = uint(home.x + home.y * uGridWidth);
            cache[cacheOffset(1u, id)] = referenceCell;
        } else {
            referenceCell = cache[cacheOffset(1u, id)];
        }
        uint epoch = cache[stateOffset(STATE_GRID_EPOCH)];
        ivec2 home = ivec2(referenceCell % uint(uGridWidth), referenceCell / uint(uGridWidth));
        int radius = direct ? uNeighborCellRadius : uSearchRadius;
        // Nothing to find: the stencil is left out and the list stays empty.
        bool skip = uNoHardPairs != 0 || fluidBody(id) && !solidNear(home, radius, epoch);
#ifdef RIGID
        skip = skip || ownTag != 0u && ownBlockOnly(home, radius, epoch, ownTag);
#endif
        ivec2 size = skip ? ivec2(0) : stencilSize(radius);
        for (int y = 0; y < size.y; y++) {
            for (int x = 0; x < size.x; x++) {
                ivec2 cell = wrapCell(stencilOrigin(home, radius) + ivec2(x, y));
                uint encoded = headBody(heads[cell.x + cell.y * uGridWidth], epoch);
                while (encoded != 0u) {
                    uint other = encoded - 1u;
                    GridNode node = nodes[other];
#ifdef RIGID
                    // Members of one block never touch: not even read.
                    bool sameBlock = ownTag != 0u && node.tag == ownTag;
#else
                    bool sameBlock = false;
#endif
                    if (other != id && !sameBlock) {
                        // A grid built in this pass holds exactly the positions
                        // read here; a retained grid holds older ones.
                        vec2 otherPosition = rebuild ? node.position : bodies[other].xy;
                        float distanceSquared = pairDistanceSquared(id, position, other, otherPosition);
                        // In liquid mode only hard pairs are candidates, so
                        // toggling it must rebuild the lists.
                        if (rebuild && !direct) {
#ifdef RIGID
                            if (distanceSquared <= uCandidateRadiusSquared && hardPair(ownMaterial, materials[other])) {
#else
                            if (distanceSquared <= uCandidateRadiusSquared && hardPair(id, other)) {
#endif
                                if (neighbors < NEIGHBOR_SLOTS) cache[cacheOffset(2u + neighbors, id)] = other;
                                neighbors++;
                            }
                        }
                        countContact(id, other, distanceSquared, contacts);
                    }
                    encoded = node.next;
                }
            }
        }
        if (rebuild) cache[cacheOffset(0u, id)] = direct ? DIRECT_GRID : neighbors;
    }
    // Each invocation owns its count and ordered contact cache. No atomics,
    // scan, global sort or truncated list is needed.
    contactCounts[id] = held ? contacts | HELD_BIT : contacts;
#ifdef RIGID
    int group = groupOf(ownMaterial);
    if (group >= 0) countWallContacts(group, position * uViewport);
#endif
    // Cheap density sampling steers the NEXT pass to the ordinary grid when
    // an expanded candidate stencil is expensive. Both paths remain exhaustive.
    // Vary the sampled lane to avoid aliasing row-major lattice boundaries.
    uint sampledLane = min((gl_WorkGroupID.x * 73u + 17u) & 255u,
        uint(uCount) - gl_WorkGroupID.x * 256u - 1u);
    if (gl_LocalInvocationID.x == sampledLane && contacts >= 4u) atomicAdd(cache[stateOffset(STATE_DENSE_SAMPLES)], 1u);
}
