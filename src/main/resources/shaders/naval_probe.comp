#version 430 core

#include "naval_layout.glsl"

// Naval battle: sums the bodies of every shell in flight, so the CPU learns
// where each one is and how fast it goes.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Materials { vec4 materials[]; };
layout(std430, binding = 2) buffer Sums { int sums[]; };

uniform int uCount;
uniform vec2 uViewport;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    int shell = shellOf(materials[id]);
    if (shell < 0) return;
    vec4 body = bodies[id] * vec4(uViewport, uViewport) * SHELL_SUM_SCALE;
    int base = shell * SHELL_SUM_INTS;
    atomicAdd(sums[base], 1);
    atomicAdd(sums[base + 1], int(round(body.x)));
    atomicAdd(sums[base + 2], int(round(body.y)));
    atomicAdd(sums[base + 3], int(round(body.z)));
    atomicAdd(sums[base + 4], int(round(body.w)));
}
