#version 430 core
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer Heads { uint heads[]; };
layout(std430, binding = 2) writeonly buffer Next { uint collisionNext[]; };
layout(std430, binding = 3) writeonly buffer References { vec2 references[]; };
layout(std430, binding = 4) readonly buffer CacheState { uint cacheState[]; };
layout(std430, binding = 5) readonly buffer AdaptiveState { uint adaptiveState[]; };
uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform int uAdaptive;
uniform int uSubstepIndex;
void main() {
    if (uAdaptive != 0 && uSubstepIndex >= 0 && uint(uSubstepIndex) >= adaptiveState[2]) return;
    if (cacheState[0] == 0u) return;
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec2 position = bodies[id].xy;
    references[id] = position;
    ivec2 cell = ivec2(floor(position * vec2(uGridWidth, uGridHeight)));
    cell = clamp(cell, ivec2(0), ivec2(uGridWidth - 1, uGridHeight - 1));
    collisionNext[id] = atomicExchange(heads[cell.x + cell.y * uGridWidth], id + 1u);
}
