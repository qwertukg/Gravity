#version 430 core

#include "rigid_layout.glsl"

// Naval battle: the joints of the guns. A barrel is a block of its own; this
// pass sets its rigid motion so that its pivot follows the pivot on its ship
// and it turns towards its aim, no faster than uMaximumTurn. Contacts do the
// rest: a barrel turned into its ship is stopped by it. The joint is internal
// to the ship: whatever momentum and angular momentum it gives the barrel,
// the ship gives up, so a barrel pressed against its ship drives nothing.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer CollisionBodies { vec4 collisionBodies[]; };
layout(std430, binding = 2) readonly buffer Materials { vec4 materials[]; };
layout(std430, binding = 3) readonly buffer Rigid { RigidGroup groups[MAXIMUM_GROUPS]; };

const int DRIVES = 8;
uniform int uCount;
uniform int uDrives;
uniform vec2 uViewport;
uniform int uBarrel[DRIVES];
uniform int uShip[DRIVES];
// Pivots in the rest frames of ship and barrel as glued, with the origins of
// their shapes then: the rest frames move with them as blocks break.
uniform vec2 uShipPivot[DRIVES];
uniform vec2 uShipOrigin[DRIVES];
uniform vec2 uBarrelPivot[DRIVES];
uniform vec2 uBarrelOrigin[DRIVES];
// Where the barrel points in its rest frame, and the aim in the ship's frame.
uniform vec2 uPointing[DRIVES];
uniform vec2 uAim[DRIVES];
// How fast the joint closes a gap (s), and the fastest turn (rad/s).
uniform float uJointTime;
uniform float uMaximumTurn;
// Mass of a body of a ship and of a barrel.
uniform float uShipDensity;
uniform float uBarrelDensity;

vec2 turn(vec2 rotation, vec2 v) {
    return vec2(rotation.x * v.x - rotation.y * v.y, rotation.y * v.x + rotation.x * v.y);
}

vec2 perpendicular(vec2 v) {
    return vec2(-v.y, v.x);
}

// The motion the joint of [drive] gives its barrel: centre velocity (xy) and spin (z).
vec3 jointMotion(int drive) {
    RigidGroup ship = groups[uShip[drive]];
    RigidGroup barrel = groups[uBarrel[drive]];
    vec2 shipArm = turn(ship.motion.zw, uShipPivot[drive] + ship.shape.xy - uShipOrigin[drive]);
    vec2 shipPivot = ship.frame.zw + shipArm;
    vec2 shipPivotVelocity = ship.motion.xy + ship.scalars.x * perpendicular(shipArm);
    vec2 barrelArm = turn(barrel.motion.zw, uBarrelPivot[drive] + barrel.shape.xy - uBarrelOrigin[drive]);
    vec2 barrelPivot = barrel.frame.zw + barrelArm;
    vec2 pointing = turn(barrel.motion.zw, uPointing[drive]);
    vec2 target = turn(ship.motion.zw, uAim[drive]);
    float error = atan(cross2(pointing, target), dot(pointing, target));
    float spin = ship.scalars.x + clamp(error / uJointTime, -uMaximumTurn, uMaximumTurn);
    vec2 pivotVelocity = shipPivotVelocity + (shipPivot - barrelPivot) / uJointTime;
    // The barrel turns about its pivot.
    return vec3(pivotVelocity - spin * perpendicular(barrelArm), spin);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 material = materials[id];
    if (material.z == 0.0 || material.w < 0.0) return;
    int group = int(material.w);
    vec2 position = bodies[id].xy * uViewport;
    vec2 velocity = bodies[id].zw * uViewport;
    bool driven = false;
    for (int drive = 0; drive < uDrives; drive++) {
        if (uBarrel[drive] == group) {
            vec3 motion = jointMotion(drive);
            velocity = motion.xy + motion.z * perpendicular(position - groups[group].frame.zw);
            driven = true;
        } else if (uShip[drive] == group) {
            // The ship's share: the change of the barrel's momentum and angular
            // momentum (about the ship's centre), taken back by the ship as a rigid body.
            RigidGroup ship = groups[group];
            RigidGroup barrel = groups[uBarrel[drive]];
            vec3 motion = jointMotion(drive);
            float barrelMass = barrel.scalars.z * uBarrelDensity;
            vec2 momentum = barrelMass * (motion.xy - barrel.motion.xy);
            vec2 arm = barrel.frame.zw - ship.frame.zw;
            float angular = cross2(arm, momentum) + barrel.scalars.y * uBarrelDensity * (motion.z - barrel.scalars.x);
            float shipMass = ship.scalars.z * uShipDensity;
            float shipInertia = ship.scalars.y * uShipDensity + shipMass * 1e-3;
            velocity -= momentum / shipMass + angular / shipInertia * perpendicular(position - ship.frame.zw);
            driven = true;
        }
    }
    if (!driven) return;
    bodies[id].zw = velocity / uViewport;
    collisionBodies[id].zw = velocity / uViewport;
}
