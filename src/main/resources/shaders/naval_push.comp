#version 430 core

// Naval battle: a ship's engine. Every member of block uGroup gains the same
// velocity; the rigid projection then moves the block by it, through its
// centre of mass, keeping its spin.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer CollisionBodies { vec4 collisionBodies[]; };
layout(std430, binding = 2) readonly buffer Materials { vec4 materials[]; };

uniform int uCount;
uniform float uGroup;
// Velocity change in viewport units per second.
uniform vec2 uDelta;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 material = materials[id];
    if (material.z == 0.0 || material.w != uGroup) return;
    vec2 velocity = bodies[id].zw + uDelta;
    bodies[id].zw = velocity;
    collisionBodies[id].zw = velocity;
}
