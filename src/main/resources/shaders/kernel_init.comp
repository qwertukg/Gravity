#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer KernelX { vec2 kernelX[]; };
layout(std430, binding = 1) writeonly buffer KernelY { vec2 kernelY[]; };

uniform int uGridWidth;
uniform int uGridHeight;
uniform int uPhysicalWidth;
uniform int uPhysicalHeight;
uniform float uDomainAspect;
uniform float uGravity;
uniform float uInitialTotalMass;
uniform float uSigmaCells;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint width = uint(uGridWidth);
    uint height = uint(uGridHeight);
    if (id >= width * height) return;

    int rawX = int(id % width);
    int rawY = int(id / width);
    int offsetX = rawX <= uGridWidth / 2 ? rawX : rawX - uGridWidth;
    int offsetY = rawY <= uGridHeight / 2 ? rawY : rawY - uGridHeight;
    float dx = float(offsetX) * uDomainAspect / float(uPhysicalWidth);
    float dy = float(offsetY) / float(uPhysicalHeight);
    float rSquared = dx * dx + dy * dy;
    if (rSquared == 0.0) {
        kernelX[id] = vec2(0.0);
        kernelY[id] = vec2(0.0);
        return;
    }

    float sigma = uSigmaCells / float(uPhysicalHeight);
    float longWeight = 1.0 - exp(-rSquared / (2.0 * sigma * sigma));
    // Convolution is indexed target-source, so the attractive kernel is -delta/r².
    float scale = -uGravity * longWeight / (uInitialTotalMass * rSquared);
    kernelX[id] = vec2(scale * dx / uDomainAspect, 0.0);
    kernelY[id] = vec2(scale * dy, 0.0);
}
