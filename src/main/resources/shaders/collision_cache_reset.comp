#version 430 core
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer CacheState { uint cacheState[]; };
layout(std430, binding = 1) readonly buffer AdaptiveState { uint adaptiveState[]; };
uniform int uCount;
uniform int uDenseSampleThreshold;
uniform int uAdaptive;
uniform int uSubstepIndex;
void main() {
    if (uAdaptive != 0 && uSubstepIndex >= 0 && uint(uSubstepIndex) >= adaptiveState[2]) return;
    // [0] rebuild flag, [1] build population, [2] rebuild counter,
    // [3] direct-grid mode, [4] sampled dense bodies in the previous pass.
    // A previous direct pass has contacts but no reusable candidate list.
    bool dense = cacheState[4] >= uint(uDenseSampleThreshold);
    cacheState[0] = cacheState[1] != uint(uCount) || cacheState[3] != 0u || dense ? 1u : 0u;
    cacheState[3] = dense ? 1u : 0u;
    cacheState[4] = 0u;
}
