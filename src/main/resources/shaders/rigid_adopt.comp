#version 430 core
layout(local_size_x = 256) in;
#include "rigid_layout.glsl"
layout(std430, binding = 0) buffer Members { int members[]; };
layout(std430, binding = 1) buffer Materials { vec4 materials[]; };
layout(std430, binding = 2) buffer Groups {
    RigidGroup groups[MAXIMUM_GROUPS];
    int impacts[CONTACT_KEYS];
    int nextImpacts[CONTACT_KEYS];
    int contactStates[CONTACT_KEYS];
    int idlePasses[CONTACT_KEYS];
    int pairContacts[CONTACT_KEYS];
    float shapes[];
};
uniform int uGroup;
uniform int uFirstSlot;
uniform int uSlots;
#ifdef PIECE
// A piece the CPU glued from a look a step or two old (RigidBlocks.split):
// its slots name the slots of block [uParent] it came from, and this pass
// gives them the bodies those hold now, and the piece the parent's motion now.
layout(std430, binding = 3) buffer Broken {
    uint brokenCounts[MAXIMUM_GROUPS];
    uint movedCounts[MAXIMUM_GROUPS];
    uint broken[];
};
layout(std430, binding = 4) buffer FractureGroups { uvec4 fractureGroups[]; };
uniform int uParent;
// The piece's centre in the parent's rest frame of the look, and the
// parent's shape origin then: the frame has moved with the origin since.
uniform vec2 uCenter;
uniform vec2 uOrigin;
uniform int uMovedBase;
uniform int uBounded;
uniform vec2 uViewport;
#endif

// Group [uGroup] starts afresh (RigidBlocks): the bodies listed in its
// slots name it, and its contact memory with every partner is forgotten,
// whatever a block of that index met before.
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < uint(uSlots)) {
        int slot = uFirstSlot + int(index);
        int body = members[slot];
#ifdef PIECE
        if (body >= 0) {
            body = members[body];
            // Broken off the parent since the look: the piece lets it go at
            // once, as a member glued elsewhere (rigid_fracture.comp), so its
            // mass and shape leave with it.
            members[slot] = body >= 0 ? body : MEMBER_GONE;
            if (body < 0) {
                broken[uint(uMovedBase) + uint(uFirstSlot) + atomicAdd(movedCounts[uGroup], 1u)] = uint(slot);
                atomicAdd(fractureGroups[uGroup].z, 1u);
            }
        }
#endif
        if (body >= 0) materials[body] = vec4(materials[body].xy, 1.0, float(uGroup));
    }
    if (index < uint(CONTACT_PARTNERS)) {
        int partner = int(index);
        int key = min(uGroup, partner) * CONTACT_PARTNERS + max(uGroup, partner);
        impacts[key] = 0;
        nextImpacts[key] = 0;
        contactStates[key] = 0;
        idlePasses[key] = 0;
        pairContacts[key] = 0;
    }
#ifdef PIECE
    if (index == 0u) {
        // The motion of the parent at the piece's centre, as it is now.
        RigidGroup parent = groups[uParent];
        vec2 center = uCenter + parent.shape.xy - uOrigin;
        vec2 rotation = parent.motion.zw;
        vec2 arm = vec2(rotation.x * center.x - rotation.y * center.y, rotation.y * center.x + rotation.x * center.y);
        vec2 position = parent.frame.zw + arm;
        if (uBounded == 0) position -= floor(position / uViewport) * uViewport;
        float spin = parent.scalars.x;
        groups[uGroup].frame = vec4(position, position);
        groups[uGroup].motion = vec4(parent.motion.xy + spin * vec2(-arm.y, arm.x), rotation);
        groups[uGroup].scalars.x = spin;
        groups[uGroup].pose = vec4(position, rotation);
    }
#endif
}
