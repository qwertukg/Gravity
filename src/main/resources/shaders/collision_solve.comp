#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer InputBodies { vec4 inputBodies[]; };
layout(std430, binding = 1) writeonly buffer OutputBodies { vec4 outputBodies[]; };
layout(std430, binding = 2) readonly buffer Heads { uint heads[]; };
layout(std430, binding = 3) readonly buffer CollisionNext { uint collisionNext[]; };
layout(std430, binding = 4) readonly buffer ContactCounts { uint contactCounts[]; };
layout(std430, binding = 5) writeonly buffer Pressures { float pressures[]; };
layout(std430, binding = 6) buffer AdaptiveState { uint adaptiveState[]; };

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform vec2 uViewport;
uniform float uDiameterPixels;
uniform int uNeighborCellRadius;
uniform int uDenseContactThreshold;
uniform float uRestitutionCoefficient;
uniform float uCoincidentDistanceSquaredEpsilon;
uniform float uSubstepDt;
uniform float uTimeStep;
uniform int uWritePressure;
uniform int uAdaptive;
uniform int uSubstepIndex;
uniform int uBounded;
#ifdef RIGID
uniform float uDriftDt;
#endif

// Largest float below 1: a body clamped to a wall stays in the last grid cell.
const float MAXIMUM_UNIT = 0.99999994;
#include "collision_material.glsl"
#ifdef RIGID
#include "collision_rigid.glsl"
#include "collision_rigid_contact.glsl"
// Drift of this pass, by which block poses are extrapolated.
float driftDt = 0.0;
#endif

ivec2 wrapCell(ivec2 cell) {
    if (cell.x < 0) cell.x += uGridWidth;
    else if (cell.x >= uGridWidth) cell.x -= uGridWidth;
    if (cell.y < 0) cell.y += uGridHeight;
    else if (cell.y >= uGridHeight) cell.y -= uGridHeight;
    return cell;
}

// A wall is an immovable body: the moving body takes the whole correction
// that a pair would split, with the same restitution and position-to-velocity
// conversion as body-body contacts.
void wallContact(uint id, vec2 positionPixels, float distance, vec2 normal, vec2 velocityPixels,
    float pressureWeight, float friction, float effectiveSubstepDt, inout vec2 positionCorrection,
    inout vec2 velocityCorrection, inout float pressure) {
    float penetration = 0.5 * uDiameterPixels - distance;
    if (penetration <= 0.0) return;
#ifdef RIGID
    float weight = rigidPair(id, id) ? rigidWallWeight(id, positionPixels, normal, driftDt) : pressureWeight;
#else
    float weight = pressureWeight;
#endif
    positionCorrection += normal * (penetration * weight);
    float normalSpeed = dot(velocityPixels, normal);
    if (normalSpeed < 0.0) {
        velocityCorrection -= normal *
            ((1.0 + uRestitutionCoefficient) * normalSpeed * weight);
    }
    if (friction > 0.0) {
        // The wall has the body's own friction coefficient.
        velocityCorrection += frictionCorrection(velocityPixels, normal, normalSpeed,
            weight * ((1.0 + uRestitutionCoefficient) * max(-normalSpeed, 0.0) +
                penetration / effectiveSubstepDt),
            weight, friction);
    }
    if (uWritePressure != 0) {
        pressure += pressureWeight * (
            penetration / effectiveSubstepDt + max(-normalSpeed, 0.0)
        );
    }
}

void wallContacts(uint id, vec2 positionPixels, vec2 velocityPixels, uint ownContacts,
    float friction, float effectiveSubstepDt, inout vec2 positionCorrection,
    inout vec2 velocityCorrection, inout float pressure) {
    if (uBounded == 0) return;
    // Counted as one more contact so body pairs keep their symmetric weights.
    // A member of a block takes its block's rigid weight instead.
    float weight = 1.0 / float(ownContacts + 1u);
    wallContact(id, positionPixels, positionPixels.x, vec2(1.0, 0.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
    wallContact(id, positionPixels, uViewport.x - positionPixels.x, vec2(-1.0, 0.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
    wallContact(id, positionPixels, positionPixels.y, vec2(0.0, 1.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
    wallContact(id, positionPixels, uViewport.y - positionPixels.y, vec2(0.0, -1.0), velocityPixels, weight,
        friction, effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
}

vec2 fallbackNormal(uint first, uint second) {
    uint low = min(first, second);
    uint high = max(first, second);
    uint hash = low * 1664525u + high * 1013904223u;
    float angle = float(hash & 65535u) * (6.28318530718 / 65536.0);
    vec2 normal = vec2(cos(angle), sin(angle));
    return first < second ? normal : -normal;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    if (
        uAdaptive != 0 &&
        uSubstepIndex >= 0 &&
        uint(uSubstepIndex) >= adaptiveState[2]
    ) return;

    vec4 body = inputBodies[id];
    vec2 positionPixels = body.xy * uViewport;
    vec2 velocityPixels = body.zw * uViewport;
    ivec2 home = ivec2(floor(
        body.xy * vec2(uGridWidth, uGridHeight)
    ));
    float diameterSquared = uDiameterPixels * uDiameterPixels;

    vec2 positionCorrection = vec2(0.0);
    vec2 velocityCorrection = vec2(0.0);
    float pressure = 0.0;
    uint ownContacts = contactCounts[id];
    float effectiveSubstepDt = uAdaptive != 0
        ? uTimeStep / float(max(adaptiveState[2], 1u))
        : uSubstepDt;
#ifdef RIGID
    driftDt = uAdaptive != 0 && uDriftDt != 0.0 ? effectiveSubstepDt : uDriftDt;
#endif
    if (uWritePressure != 0 && uAdaptive != 0) {
        atomicMax(adaptiveState[3], ownContacts);
        if (ownContacts >= uint(uDenseContactThreshold)) {
            atomicAdd(adaptiveState[4], 1u);
        }
    }

    for (int dy = -uNeighborCellRadius; dy <= uNeighborCellRadius; ++dy) {
        for (int dx = -uNeighborCellRadius; dx <= uNeighborCellRadius; ++dx) {
            ivec2 cell = wrapCell(home + ivec2(dx, dy));
            uint encoded = heads[cell.x + cell.y * uGridWidth];
            while (encoded != 0u) {
                uint otherId = encoded - 1u;
                if (otherId != id && hardPair(id, otherId)) {
                    vec4 other = inputBodies[otherId];
                    // Match the counter's rounded contact predicate exactly.
                    precise vec2 delta = positionPixels - other.xy * uViewport;
                    // Walls: no minimum image, bodies across an edge never touch.
                    if (uBounded == 0) delta -= floor(delta / uViewport + vec2(0.5)) * uViewport;
                    precise float distanceSquared = dot(delta, delta);
                    float reachSquared = contactReachSquared(id, otherId);
#ifdef RIGID
                    if (distanceSquared < reachSquared && rigidPair(id, otherId)) {
                        rigidContact(id, otherId, positionPixels, velocityPixels, other.xy * uViewport,
                            other.zw * uViewport, ownContacts, contactCounts[otherId], driftDt,
                            effectiveSubstepDt, positionCorrection, velocityCorrection, pressure);
                    } else
#endif
                    if (distanceSquared < reachSquared) {
                        float distance = sqrt(max(
                            distanceSquared,
                            uCoincidentDistanceSquaredEpsilon
                        ));
                        vec2 normal =
                            distanceSquared > uCoincidentDistanceSquaredEpsilon
                            ? delta / distance
                            : fallbackNormal(id, otherId);
                        float penetration = uDiameterPixels - distance;
                        float pairWeight = 1.0 / float(max(
                            max(ownContacts, contactCounts[otherId]),
                            1u
                        ));

                        vec4 ownMaterial = materials[id];
                        vec4 otherMaterial = materials[otherId];
                        float share = massShare(ownMaterial, otherMaterial);

                        // Symmetric weights keep every impulse equal and
                        // opposite, including crowded multi-body contacts.
                        positionCorrection +=
                            normal * (share * penetration * pairWeight);

                        vec2 otherVelocityPixels = other.zw * uViewport;
                        vec2 relativeVelocity =
                            velocityPixels - otherVelocityPixels;
                        float relativeNormalSpeed =
                            dot(relativeVelocity, normal);
                        if (relativeNormalSpeed < 0.0) {
                            // e=0: the approaching normal components meet
                            // at the pair's centre-of-mass velocity.
                            velocityCorrection -= normal *
                                (
                                    share *
                                    (1.0 + uRestitutionCoefficient) *
                                    relativeNormalSpeed *
                                    pairWeight
                                );
                        }
                        float friction = pairFriction(ownMaterial, otherMaterial);
                        if (friction > 0.0) {
                            velocityCorrection += frictionCorrection(
                                relativeVelocity, normal, relativeNormalSpeed,
                                share * pairWeight * (
                                    (1.0 + uRestitutionCoefficient) *
                                        max(-relativeNormalSpeed, 0.0) +
                                    penetration / effectiveSubstepDt
                                ),
                                share * pairWeight, friction);
                        }
                        if (uWritePressure != 0) {
                            if (uAdaptive != 0) {
                                atomicMax(
                                    adaptiveState[1],
                                    floatBitsToUint(penetration)
                                );
                            }
                            pressure += 0.5 * pairWeight * (
                                penetration / effectiveSubstepDt +
                                max(-relativeNormalSpeed, 0.0)
                            );
                        }

                    }
                }
                encoded = collisionNext[otherId];
            }
        }
    }

    wallContacts(id, positionPixels, velocityPixels, ownContacts, materials[id].y, effectiveSubstepDt,
        positionCorrection, velocityCorrection, pressure);
#ifdef RIGID
    positionPixels += resolveGuards(positionPixels, driftDt);
#endif
    positionPixels += positionCorrection;
    velocityPixels += velocityCorrection + positionCorrection / effectiveSubstepDt;
    vec2 position;
#ifdef RIGID
    if (rigidPair(id, id)) {
        // A member's correction stands for its block's and may be large; the
        // rigid projection reads it as is and places the member itself.
        position = positionPixels / uViewport;
    } else
#endif
    if (uBounded != 0) {
        position = clamp(positionPixels / uViewport, vec2(0.0), vec2(MAXIMUM_UNIT));
    } else {
        positionPixels = mod(positionPixels, uViewport);
        position = positionPixels / uViewport;
    }

    outputBodies[id] = vec4(position, velocityPixels / uViewport);
    // Fluid pressure comes from the liquid passes.
    if (uWritePressure != 0 && !fluidBody(id)) pressures[id] = pressure;
}
