#version 430 core

#include "naval_layout.glsl"
#include "rigid_layout.glsl"

// Naval battle: a shell or a missile goes off. A shell's bodies, summed by
// naval_probe.comp just before, or the bodies of missile block uGroup (its
// glue is undone after, RigidBlocks.dissolve) fly apart from their centre, the
// outer ones fastest, as hot fragments; up to uFire parked fire bodies are lit
// around them and thrown out: the fireball (naval_fire.comp). The blast is
// nothing but these bodies hitting what is around.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer CollisionBodies { vec4 collisionBodies[]; };
layout(std430, binding = 2) buffer Materials { vec4 materials[]; };
layout(std430, binding = 3) buffer Sums { int sums[]; };
layout(std430, binding = 4) readonly buffer Rigid { RigidGroup groups[MAXIMUM_GROUPS]; };

uniform int uCount;
uniform int uShell;
// A missile block to blow up instead of shell uShell, or -1.
uniform int uGroup;
uniform vec2 uViewport;
uniform float uRadius;
uniform float uSpeed;
uniform int uFire;
// Radius (px) of the disc the fire bodies are lit in, and their fastest speed.
uniform float uFireRadius;
uniform float uFireSpeed;
// Mass of a fire body on the mean: each is lit with half to one and a half of
// it, which also sets how fast it cools (naval_particles.vert).
uniform float uFireMass;
// The tag of what is born now: -(HOT_BASE + step).
uniform float uHotTag;
// How far a missile's fragments fan out along its axis at its ends (tan of the slant).
const float FAN = 0.8;

bool blownUp(vec4 material) {
    if (uGroup >= 0) return material.z != 0.0 && material.w == float(uGroup);
    return shellOf(material) == uShell;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 material = materials[id];
    bool parked = material.z != 0.0 && material.w == PARKED_TAG;
    if (!parked && !blownUp(material)) return;
    int base = uShell * SHELL_SUM_INTS;
    vec2 center;
    vec2 velocity;
    if (uGroup >= 0) {
        center = groups[uGroup].frame.zw;
        velocity = groups[uGroup].motion.xy;
    } else {
        float count = float(sums[base]);
        if (count == 0.0) return;
        center = vec2(sums[base + 1], sums[base + 2]) / (SHELL_SUM_SCALE * count);
        velocity = vec2(sums[base + 3], sums[base + 4]) / (SHELL_SUM_SCALE * count);
    }
    if (parked) {
        if (uFire <= 0) return;
        int index = atomicAdd(sums[base + 5], 1);
        if (index >= uFire) return;
        float angle = navalRandom(id, uint(index) * 3u) * 6.2831853;
        vec2 direction = vec2(cos(angle), sin(angle));
        // A filled disc, thrown out faster the further out.
        float reach = sqrt(navalRandom(id, uint(index) * 3u + 1u));
        vec2 position = center + direction * reach * uFireRadius;
        float speed = uFireSpeed * (0.2 + 0.8 * reach) * (0.6 + 0.4 * navalRandom(id, uint(index) * 3u + 2u));
        vec4 body = vec4(position / uViewport, (0.15 * velocity + direction * speed) / uViewport);
        bodies[id] = body;
        collisionBodies[id] = body;
        float mass = uFireMass * (0.5 + navalRandom(id, uint(index) * 3u + 3u));
        materials[id] = vec4(mass, material.yz, uHotTag);
        return;
    }
    vec4 body = bodies[id];
    vec2 offset = body.xy * uViewport - center;
    float distance = length(offset);
    // The middle body has no outward direction of its own: a random one.
    float angle = navalRandom(id, 7u) * 6.2831853;
    vec2 direction = distance > 1e-3 ? offset / distance : vec2(cos(angle), sin(angle));
    float speed = uSpeed * (0.3 + 0.7 * min(distance / uRadius, 1.0));
    if (uGroup >= 0) {
        // A missile's case bursts across its axis, a belt of fragments fanning
        // out to either side, the further along it the more slanted.
        vec2 axis = groups[uGroup].motion.zw;
        axis = vec2(-axis.y, axis.x);
        float along = dot(offset, axis);
        float across = cross2(axis, offset);
        float side = abs(across) > 0.05 ? sign(across) : (navalRandom(id, 11u) < 0.5 ? -1.0 : 1.0);
        vec2 outward = side * vec2(-axis.y, axis.x);
        direction = normalize(outward + FAN * clamp(along / uRadius, -1.0, 1.0) * axis);
        speed = uSpeed * (0.75 + 0.25 * navalRandom(id, 13u));
    }
    vec2 outward = body.zw + direction * speed / uViewport;
    bodies[id].zw = outward;
    collisionBodies[id].zw = outward;
    materials[id] = vec4(material.xyz, uHotTag);
}
