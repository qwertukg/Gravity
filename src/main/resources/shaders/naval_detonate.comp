#version 430 core

#include "naval_layout.glsl"

// Naval battle: a shell goes off. Its bodies, summed by naval_probe.comp just
// before, fly apart from their centre, the outer ones fastest, and become
// ordinary grains: the blast is nothing but them hitting what is around.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer CollisionBodies { vec4 collisionBodies[]; };
layout(std430, binding = 2) buffer Materials { vec4 materials[]; };
layout(std430, binding = 3) readonly buffer Sums { int sums[]; };

uniform int uCount;
uniform int uShell;
uniform vec2 uViewport;
uniform float uRadius;
uniform float uSpeed;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 material = materials[id];
    if (shellOf(material) != uShell) return;
    int base = uShell * SHELL_SUM_INTS;
    vec2 center = vec2(sums[base + 1], sums[base + 2]) / (SHELL_SUM_SCALE * float(sums[base]));
    vec4 body = bodies[id];
    vec2 offset = body.xy * uViewport - center;
    float distance = length(offset);
    // The middle body has no outward direction of its own: a hashed one.
    float angle = float((id * 2654435761u) >> 8) * (6.2831853 / 16777216.0);
    vec2 direction = distance > 1e-3 ? offset / distance : vec2(cos(angle), sin(angle));
    float speed = uSpeed * (0.3 + 0.7 * min(distance / uRadius, 1.0));
    vec2 velocity = body.zw + direction * speed / uViewport;
    bodies[id].zw = velocity;
    collisionBodies[id].zw = velocity;
    materials[id] = vec4(material.xyz, -1.0);
}
