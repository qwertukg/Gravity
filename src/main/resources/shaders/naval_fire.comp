#version 430 core

#include "naval_layout.glsl"

// Naval battle, before every step: the fire of blasts. A fire body is hot gas:
// the air around holds it up against the field and lifts it while it is hot,
// and drags it to a stop, so a fireball bursts out, slows, rises and cools.
// Burnt out, it is parked again in a row along the ceiling, at rest, until a
// blast lights it. A fragment of a shell is slowed by the air as its square
// speed while it glows, so shrapnel stops within a few hundred px instead of
// crossing the sea, and then cools into an ordinary grain.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer CollisionBodies { vec4 collisionBodies[]; };
layout(std430, binding = 2) buffer Materials { vec4 materials[]; };
layout(std430, binding = 3) buffer Parked { int parked; };

uniform int uCount;
uniform vec2 uViewport;
uniform float uStep;
uniform float uDt;
// The downward field, px/s².
uniform float uField;
// Lift of the hottest gas beyond the field (px/s²), how fast the gas cools
// (s), the drag of the air (1/s) and how long a fire burns (s).
uniform float uLift;
uniform float uHeatTime;
uniform float uDrag;
uniform float uFireLife;
uniform float uFragmentCool;
// The air's drag on a fragment (1/px).
uniform float uFragmentDrag;
uniform float uDiameter;
uniform int uPerRow;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 material = materials[id];
    if (material.z == 0.0) return;
    if (material.w != PARKED_TAG) {
        if (!isHot(material)) return;
        float age = hotAge(material, uStep, uDt);
        if (material.x >= FIRE_MASS_LIMIT) {
            if (age > uFragmentCool) {
                materials[id] = vec4(material.xyz, -1.0);
                return;
            }
            // Quadratic drag, taken implicitly so that it never reverses a fast fragment.
            vec2 velocity = bodies[id].zw * uViewport;
            velocity /= 1.0 + uFragmentDrag * length(velocity) * uDt;
            bodies[id].zw = velocity / uViewport;
            collisionBodies[id].zw = velocity / uViewport;
            return;
        }
        if (age < uFireLife) {
            float heat = exp(-age / uHeatTime);
            vec2 velocity = bodies[id].zw * uViewport;
            velocity.y += (uField + uLift * heat) * uDt;
            velocity *= exp(-uDrag * uDt);
            bodies[id].zw = velocity / uViewport;
            collisionBodies[id].zw = velocity / uViewport;
            return;
        }
        materials[id] = vec4(material.xyz, PARKED_TAG);
    }
    int slot = atomicAdd(parked, 1);
    vec2 position = vec2(
        (float(slot % uPerRow) + 0.5) * uDiameter,
        uViewport.y - (float(slot / uPerRow) + 0.5) * uDiameter
    );
    vec4 body = vec4(position / uViewport, 0.0, 0.0);
    bodies[id] = body;
    collisionBodies[id] = body;
}
