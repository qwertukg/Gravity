#version 430 core
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Positions { vec2 positions[]; };
layout(std430, binding = 1) readonly buffer Heads { int heads[]; };
layout(std430, binding = 2) readonly buffer Next { int next[]; };
layout(std430, binding = 3) writeonly buffer Lambdas { float lambdas[]; };
layout(std430, binding = 4) writeonly buffer Pressures { float pressures[]; };
layout(std430, binding = 8) readonly buffer Materials { vec4 materials[]; };
uniform int uCount;
uniform float uRelaxation;
uniform int uWritePressure;
uniform float uPressureScale;
uniform int uIteration;
uniform float uListRadiusSquared;
#include "liquid_kernel.glsl"

float density = 0.0;
vec2 ownGradient = vec2(0.0);
float otherGradients = 0.0;

void addNeighbour(uint id, uint other, bool solid, vec2 delta, float distanceSquared) {
    // Both kernels are zero from the kernel radius on.
    if (distanceSquared >= uKernelRadius * uKernelRadius) return;
    density += poly6(distanceSquared);
    vec2 gradient = spikyGradient(delta, sqrt(distanceSquared), id, other) / uRestDensity;
    ownGradient += gradient;
    // A block moves as a whole, so its bodies barely respond.
    if (!solid) otherGradients += dot(gradient, gradient);
}

// Density constraint C = max(rho / rho0 - 1, 0) of every fluid body and its
// multiplier lambda, stored times the body's mass. Solid (block) bodies add
// to the density around them like fluid does, so the liquid presses on a
// block's surface, but they have no constraint of their own. The constraint
// only pushes: a free surface never pulls bodies together.
void main() {
    uint id = gl_GlobalInvocationID.x;
    // The apply pass of this iteration raises the next one's flag.
    if (id == 0u) lists[flagOffset(uIteration + 1)] = 0u;
    if (id >= uint(uCount)) return;
    vec2 position = positions[id];
    vec4 material = materials[id];
    bool solid = material.z != 0.0;
    uint count = lists[listOffset(PLANE_COUNT, id)];
    if (lists[flagOffset(uIteration)] != 0u) {
        // Solid bodies need lists too: the apply pass gives them the reaction.
        lists[listOffset(PLANE_REFERENCE, id)] = floatBitsToUint(position.x);
        lists[listOffset(PLANE_REFERENCE + 1u, id)] = floatBitsToUint(position.y);
        count = 0u;
        ivec2 home = homeCell(id);
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                ivec2 cell = home + ivec2(dx, dy);
                if (!neighbourCell(cell)) continue;
                for (int other = heads[liquidCellIndex(cell)]; other >= 0; other = next[other]) {
                    if (uint(other) == id) continue;
                    vec2 delta = pixelDelta(position, positions[other]);
                    float distanceSquared = dot(delta, delta);
                    if (distanceSquared >= uListRadiusSquared) continue;
                    bool otherSolid = materials[other].z != 0.0;
                    if (count < LIST_SLOTS) {
                        lists[listOffset(PLANE_ENTRIES + count, id)] = uint(other) | (otherSolid ? SOLID_NEIGHBOUR : 0u);
                    }
                    count++;
                    if (!solid) addNeighbour(id, uint(other), otherSolid, delta, distanceSquared);
                }
            }
        }
        lists[listOffset(PLANE_COUNT, id)] = count;
    } else if (!solid && count <= LIST_SLOTS) {
        for (uint slot = 0u; slot < count; slot++) {
            uint entry = lists[listOffset(PLANE_ENTRIES + slot, id)];
            uint other = entry & ~SOLID_NEIGHBOUR;
            vec2 delta = pixelDelta(position, positions[other]);
            addNeighbour(id, other, (entry & SOLID_NEIGHBOUR) != 0u, delta, dot(delta, delta));
        }
    } else if (!solid) {
        ivec2 home = homeCell(id);
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                ivec2 cell = home + ivec2(dx, dy);
                if (!neighbourCell(cell)) continue;
                for (int other = heads[liquidCellIndex(cell)]; other >= 0; other = next[other]) {
                    if (uint(other) == id) continue;
                    vec2 delta = pixelDelta(position, positions[other]);
                    addNeighbour(id, uint(other), materials[other].z != 0.0, delta, dot(delta, delta));
                }
            }
        }
    }
    if (solid) {
        lambdas[id] = 0.0;
        return;
    }
    // The body itself, at distance zero.
    density += poly6(0.0);
    // Walls are immovable: they add density and its gradient, nothing else.
    vec3 walls = wallsDensity(position * uViewport);
    density += walls.x;
    ownGradient += walls.yz / uRestDensity;
    float constraint = max(density / uRestDensity - 1.0, 0.0);
    float lambda = -constraint / (dot(ownGradient, ownGradient) + otherGradients + uRelaxation);
    lambdas[id] = lambda * material.x;
    if (uWritePressure != 0) pressures[id] = constraint * uPressureScale;
}
