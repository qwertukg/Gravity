#version 430 core
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Destinations { uint destinations[]; };
layout(std430, binding = 1) readonly buffer Materials { vec4 materials[]; };
layout(std430, binding = 2) writeonly buffer SortedMaterials { vec4 sortedMaterials[]; };
uniform int uCount;

// Materials follow their bodies through the same permutation as the scatter.
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    sortedMaterials[destinations[id]] = materials[id];
}
