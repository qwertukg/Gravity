#version 430 core
layout(local_size_x = 256) in;
#include "rigid_layout.glsl"
layout(std430, binding = 0) readonly buffer Partials { vec4 partials[]; };
layout(std430, binding = 1) buffer Groups { RigidGroup groups[]; };
uniform vec2 uViewport;
uniform int uBounded;
uniform float uBodyRadius;

shared vec4 sharedA[256];
shared vec4 sharedB[256];

// One workgroup per group: adds the tile partials and fits the rigid motion
// that keeps the group's momentum and angular momentum.
void main() {
    uint group = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    ivec4 tiles = groups[group].tiles;
    vec4 a = vec4(0.0);
    vec4 b = vec4(0.0);
    for (int tile = tiles.x + int(lane); tile < tiles.x + tiles.y; tile += 256) {
        a += partials[2 * tile];
        b += partials[2 * tile + 1];
    }
    sharedA[lane] = a;
    sharedB[lane] = b;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (lane < stride) {
            sharedA[lane] += sharedA[lane + stride];
            sharedB[lane] += sharedB[lane + stride];
        }
        barrier();
    }
    if (lane != 0u) return;

    RigidGroup rigid = groups[group];
    float mass = rigid.scalars.z;
    vec2 center = sharedA[0].xy / mass;
    vec2 velocity = sharedA[0].zw / mass;
    // Best-fit rotation of the rest shape onto the current positions.
    vec2 fit = vec2(sharedB[0].y, sharedB[0].x);
    float fitLength = length(fit);
    vec2 rotation = fitLength > 0.0 ? fit / fitLength : rigid.motion.zw;
    // L about the centre: sum(p x v) - c x (m V).
    float angularMomentum = sharedB[0].z - mass * cross2(center, velocity);
    float inertia = rigid.scalars.y;
    float angularVelocity = inertia > 0.0 ? angularMomentum / inertia : 0.0;

    center += rigid.frame.xy;
    // Out of the blocks it was pressed into, position only (collision_rigid_contact.glsl).
    center += vec2(rigid.guard.xy - rigid.guard.zw) / GUARD_SCALE;
    rigid.guard = ivec4(0);
    if (uBounded == 0) {
        center -= floor(center / uViewport) * uViewport;
    } else {
        // A block never reaches into a wall, however hard it is pressed: its
        // member contacts with the wall share the block with all its other
        // contacts and may not have pushed it out yet. Move it back inside
        // and take away the speed into the wall, which stops it.
        vec2 low = vec2(1e30);
        vec2 high = vec2(-1e30);
        for (int corner = 0; corner < 4; corner++) {
            vec2 rest = vec2((corner & 1) == 0 ? rigid.bounds.x : rigid.bounds.y,
                (corner & 2) == 0 ? rigid.bounds.z : rigid.bounds.w);
            vec2 arm = vec2(rotation.x * rest.x - rotation.y * rest.y, rotation.y * rest.x + rotation.x * rest.y);
            low = min(low, arm);
            high = max(high, arm);
        }
        vec2 shift = max(vec2(uBodyRadius) - (center + low), vec2(0.0)) -
            max(center + high + uBodyRadius - uViewport, vec2(0.0));
        // A block wider than the screen stays where it is.
        shift *= vec2(lessThan(high - low + 2.0 * uBodyRadius, uViewport));
        center += shift;
        if (shift.x * velocity.x < 0.0) velocity.x = 0.0;
        if (shift.y * velocity.y < 0.0) velocity.y = 0.0;
    }
    rigid.frame = vec4(center, center);
    rigid.motion = vec4(velocity, rotation);
    rigid.scalars.x = angularVelocity;
    groups[group] = rigid;
}
