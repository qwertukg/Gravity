#version 430 core

layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer AdaptiveState { uint adaptiveState[]; };
layout(std430, binding = 1) writeonly buffer DispatchCommands { uint commands[]; };

uniform int uMaximumSubsteps;
uniform int uBodyWorkgroups;
uniform int uDenseContactBodyThreshold;
uniform float uTimeStep;
uniform float uDiameterPixels;
uniform float uAllowedDisplacementFraction;
uniform float uAllowedPenetrationFraction;

void main() {
    bool firstStep = adaptiveState[2] == 0u;
    float speed = uintBitsToFloat(adaptiveState[0]);
    float previousPenetration = uintBitsToFloat(adaptiveState[1]);
    uint previousDenseContactBodies = adaptiveState[4];
    float allowedDisplacement =
        uDiameterPixels * uAllowedDisplacementFraction;
    float allowedPenetration =
        uDiameterPixels * uAllowedPenetrationFraction;
    uint displacementSteps = uint(ceil(speed * uTimeStep / allowedDisplacement));
    uint penetrationSteps = uint(ceil(previousPenetration / allowedPenetration));
    uint required = firstStep
        ? uint(uMaximumSubsteps)
        : clamp(
            max(max(displacementSteps, penetrationSteps), 1u),
            1u,
            uint(uMaximumSubsteps)
        );
    // Highly connected contact graphs need the full Jacobi iteration budget
    // even when their instantaneous displacement is small.
    if (previousDenseContactBodies >= uint(uDenseContactBodyThreshold)) {
        required = uint(uMaximumSubsteps);
    }
    // CPU-side ping-pong swaps still happen for inactive iterations. Keep the
    // number of inactive swaps even so the current and previous buffers retain
    // their roles without a readback.
    if ((required & 1u) != (uint(uMaximumSubsteps) & 1u)) {
        required = min(required + 1u, uint(uMaximumSubsteps));
    }
    adaptiveState[2] = required;
    // The final collision pass of the new step accumulates the next value.
    adaptiveState[1] = 0u;
    adaptiveState[3] = 0u;
    adaptiveState[4] = 0u;
    for (uint index = 0u; index < uint(uMaximumSubsteps); index++) {
        uint base = index * 3u;
        // Keep one no-op workgroup for inactive iterations. Some drivers are
        // unstable with a zero-sized indirect dispatch.
        commands[base] = index < required ? uint(uBodyWorkgroups) : 1u;
        commands[base + 1u] = 1u;
        commands[base + 2u] = 1u;
    }
}
