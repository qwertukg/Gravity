#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer CollisionDeltas { ivec4 collisionDeltas[]; };

uniform int uCount;
uniform int uWidth;
uniform int uHeight;

const float VELOCITY_FIXED_SCALE = 4096.0;
const float POSITION_FIXED_SCALE = 65536.0;
const float MAX_POSITION_CORRECTION_PIXELS = 0.25;

float wrapPosition(float position) {
    return position - floor(position);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    vec2 resolution = vec2(uWidth, uHeight);
    ivec4 delta = collisionDeltas[id];
    vec4 body = bodies[id];
    body.zw += vec2(delta.xy) / (VELOCITY_FIXED_SCALE * resolution);
    vec2 positionDeltaPixels = vec2(delta.zw) / POSITION_FIXED_SCALE;
    float correctionLength = length(positionDeltaPixels);
    if (correctionLength > MAX_POSITION_CORRECTION_PIXELS) {
        positionDeltaPixels *=
            MAX_POSITION_CORRECTION_PIXELS / correctionLength;
    }
    body.xy += positionDeltaPixels / resolution;
    body.x = wrapPosition(body.x);
    body.y = wrapPosition(body.y);
    bodies[id] = body;
}
