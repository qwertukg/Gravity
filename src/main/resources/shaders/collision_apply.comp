#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer CollisionDeltas { ivec4 collisionDeltas[]; };

uniform int uCount;
uniform int uWidth;
uniform int uHeight;

const float VELOCITY_FIXED_SCALE = 4096.0;
const float POSITION_FIXED_SCALE = 65536.0;

void reflectAxis(inout float position, inout float velocity) {
    float phase = mod(position, 2.0);
    if (phase < 0.0) phase += 2.0;
    if (phase >= 1.0) {
        position = 2.0 - phase;
        velocity = -velocity;
    } else {
        position = phase;
    }
    position = min(position, 0.99999994);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    vec2 resolution = vec2(uWidth, uHeight);
    ivec4 delta = collisionDeltas[id];
    vec4 body = bodies[id];
    body.zw += vec2(delta.xy) / (VELOCITY_FIXED_SCALE * resolution);
    body.xy += vec2(delta.zw) / (POSITION_FIXED_SCALE * resolution);
    reflectAxis(body.x, body.z);
    reflectAxis(body.y, body.w);
    bodies[id] = body;
}
