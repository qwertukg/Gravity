#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer AdaptiveState { uint adaptiveState[]; };

uniform int uCount;
uniform vec2 uViewport;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    float speed = length(bodies[id].zw * uViewport);
    atomicMax(adaptiveState[0], floatBitsToUint(speed));
}
