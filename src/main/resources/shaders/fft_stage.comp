#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer InputComplex { vec2 inputComplex[]; };
layout(std430, binding = 1) writeonly buffer OutputComplex { vec2 outputComplex[]; };
layout(std430, binding = 2) readonly buffer Twiddles { vec4 twiddles[]; };

uniform int uGridWidth;
uniform int uGridHeight;
uniform int uStage;
uniform int uAxis;
uniform int uInverse;

vec2 multiplyComplex(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint widthInCells = uint(uGridWidth);
    uint heightInCells = uint(uGridHeight);
    if (id >= widthInCells * heightInCells) return;

    uint x = id % widthInCells;
    uint y = id / widthInCells;
    uint coordinate = uAxis == 0 ? x : y;
    uint width = 1u << uint(uStage);
    uint halfWidth = width >> 1u;
    uint within = coordinate & (width - 1u);
    uint pairCoordinate = within < halfWidth
        ? coordinate + halfWidth
        : coordinate - halfWidth;
    uint lowerCoordinate = within < halfWidth ? coordinate : pairCoordinate;
    uint lowerId = uAxis == 0
        ? lowerCoordinate + y * widthInCells
        : x + lowerCoordinate * widthInCells;
    uint upperId = uAxis == 0
        ? lowerCoordinate + halfWidth + y * widthInCells
        : x + (lowerCoordinate + halfWidth) * widthInCells;

    uint twiddleBase = uAxis == 0 ? 0u : widthInCells - 1u;
    uint twiddleIndex = twiddleBase + halfWidth - 1u +
        (within & (halfWidth - 1u));
    vec4 packedTwiddle = twiddles[twiddleIndex];
    vec2 twiddle = uInverse != 0 ? packedTwiddle.zw : packedTwiddle.xy;
    vec2 evenValue = inputComplex[lowerId];
    vec2 oddValue = multiplyComplex(twiddle, inputComplex[upperId]);
    outputComplex[id] = within < halfWidth ? evenValue + oddValue : evenValue - oddValue;
}
