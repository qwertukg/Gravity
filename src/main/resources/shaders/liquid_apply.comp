#version 430 core
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Heads { int heads[]; };
layout(std430, binding = 2) readonly buffer Next { int next[]; };
layout(std430, binding = 3) readonly buffer Lambdas { float lambdas[]; };
layout(std430, binding = 5) writeonly buffer OutputBodies { vec4 outputBodies[]; };
layout(std430, binding = 8) readonly buffer Materials { vec4 materials[]; };
uniform int uCount;
uniform float uDt;
uniform float uBodyRadius;
#include "liquid_kernel.glsl"
// Largest float below 1: a body clamped to a wall stays in the last grid cell.
const float MAXIMUM_UNIT = 0.99999994;

// Jacobi position correction of the density constraints, converted to
// velocity like the collision solver does (dv = dx / dt). A fluid pair moves
// by (lambda_i + lambda_j) grad W / rho0. Between fluid j and solid i the fluid
// takes lambda_j grad W / rho0 and the solid the reaction scaled by m_j / m_i,
// so every pair keeps its momentum; the rigid projection then spreads the
// solid's share over its block, which is where buoyancy comes from.
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    vec4 body = bodies[id];
    float ownLambda = lambdas[id];
    float ownMass = materials[id].x;
    vec2 correction = vec2(0.0);
    ivec2 home = homeCell(id);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 cell = home + ivec2(dx, dy);
            if (!neighbourCell(cell)) continue;
            for (int other = heads[liquidCellIndex(cell)]; other >= 0; other = next[other]) {
                if (uint(other) == id) continue;
                // Solid lambdas are zero; fluid bodies all have unit mass.
                float coefficient = ownLambda + lambdas[other] * materials[other].x / ownMass;
                if (coefficient == 0.0) continue;
                vec2 delta = pixelDelta(body.xy, bodies[other].xy);
                correction += coefficient * spikyGradient(delta, length(delta));
            }
        }
    }
    correction /= uRestDensity;
    vec2 positionPixels = body.xy * uViewport + correction;
    vec2 velocityPixels = body.zw * uViewport + correction / uDt;
    // Walls: stop a body at its radius, not at its centre. Penetration left
    // here would become dx / dt of a collision substep in the next pass.
    if (uBounded != 0) positionPixels = clamp(positionPixels, vec2(uBodyRadius), uViewport - uBodyRadius);
    vec2 position = uBounded != 0
        ? clamp(positionPixels / uViewport, vec2(0.0), vec2(MAXIMUM_UNIT))
        : fract(positionPixels / uViewport);
    outputBodies[id] = vec4(position, velocityPixels / uViewport);
}
