#version 430 core

layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer Trajectory { vec4 trajectory[]; };
layout(std430, binding = 1) readonly buffer ForceX { vec2 forceX[]; };
layout(std430, binding = 2) readonly buffer ForceY { vec2 forceY[]; };
layout(std430, binding = 3) readonly buffer Heads { int heads[]; };
layout(std430, binding = 4) readonly buffer NextBody { int nextBody[]; };
layout(std430, binding = 5) readonly buffer CellCounts { int cellCounts[]; };
layout(std430, binding = 7) readonly buffer Bodies { vec4 bodies[]; };

uniform int uStepCount;
uniform int uMeshWidth;
uniform int uMeshHeight;
uniform int uBounded;
// Uniform field switched on with the arrow keys, normalized per screen axis.
uniform vec2 uFieldAcceleration;
// G: 0 when bodies ignore each other's gravity; the uniform field still acts.
uniform int uMutualGravity;
uniform float uRestitutionCoefficient;

// Largest float below 1: a point clamped to a wall stays inside the grid.
const float MAXIMUM_UNIT = 0.99999994;
uniform int uPhysicalWidth;
uniform int uPhysicalHeight;
uniform int uNeighborRadiusX;
uniform int uNeighborRadiusY;
uniform vec2 uViewport;
uniform vec2 uOriginPixels;
uniform vec2 uVelocityPixels;
uniform float uMinimumDt;
uniform float uMaximumDt;
uniform float uTargetSegmentPixels;
uniform float uMaximumPathPixels;
uniform float uGravity;
uniform float uSigmaCells;
uniform float uDomainAspect;
uniform float uTotalMass;
uniform int uExactCellThreshold;
uniform int uMaximumHomeInteractions;
uniform float uMinimumDashPixels;
uniform float uMinimumDistanceCellFraction;

const int VERTICES_PER_STEP = 6;

ivec2 wrapCell(ivec2 cell) {
    if (cell.x < 0) cell.x += uPhysicalWidth;
    else if (cell.x >= uPhysicalWidth) cell.x -= uPhysicalWidth;
    if (cell.y < 0) cell.y += uPhysicalHeight;
    else if (cell.y >= uPhysicalHeight) cell.y -= uPhysicalHeight;
    return cell;
}

int cellIndex(ivec2 cell) {
    cell = wrapCell(cell);
    return cell.x + cell.y * uPhysicalWidth;
}

ivec2 wrapMesh(ivec2 cell) {
    // Periodic: mesh == physical grid. Walls: cells beyond an edge land in the
    // zero padding of the doubled mesh, so no mass leaks across the walls.
    if (cell.x < 0) cell.x += uMeshWidth;
    else if (cell.x >= uMeshWidth) cell.x -= uMeshWidth;
    if (cell.y < 0) cell.y += uMeshHeight;
    else if (cell.y >= uMeshHeight) cell.y -= uMeshHeight;
    return cell;
}

int forceIndex(ivec2 physicalCell) {
    ivec2 meshCell = wrapMesh(physicalCell);
    return meshCell.x + meshCell.y * uMeshWidth;
}

vec2 localAcceleration(
    vec2 sourcePosition,
    vec2 targetPosition,
    float sourceMass
) {
    vec2 deltaNormalized = sourcePosition - targetPosition;
    if (uBounded == 0) deltaNormalized -= floor(deltaNormalized + vec2(0.5));
    vec2 deltaPhysical = deltaNormalized * vec2(uDomainAspect, 1.0);
    float rSquared = dot(deltaPhysical, deltaPhysical);
    float sigma = uSigmaCells / float(uPhysicalHeight);
    float localWeight = exp(-rSquared / (2.0 * sigma * sigma));
    float cellWidth = uDomainAspect / float(uPhysicalWidth);
    float cellHeight = 1.0 / float(uPhysicalHeight);
    float minimumDistance =
        uMinimumDistanceCellFraction * min(cellWidth, cellHeight);
    float physicalScale = uGravity * sourceMass * localWeight /
        (uTotalMass * max(rSquared, minimumDistance * minimumDistance));
    return physicalScale * deltaPhysical / vec2(uDomainAspect, 1.0);
}

vec2 interpolateForce(vec2 position) {
    vec2 gridPosition = position * vec2(uPhysicalWidth, uPhysicalHeight) - 0.5;
    ivec2 base = ivec2(floor(gridPosition));
    vec2 f = fract(gridPosition);
    vec2 v00 = vec2(
        forceX[forceIndex(base)].x,
        forceY[forceIndex(base)].x
    );
    vec2 v10 = vec2(
        forceX[forceIndex(base + ivec2(1, 0))].x,
        forceY[forceIndex(base + ivec2(1, 0))].x
    );
    vec2 v01 = vec2(
        forceX[forceIndex(base + ivec2(0, 1))].x,
        forceY[forceIndex(base + ivec2(0, 1))].x
    );
    vec2 v11 = vec2(
        forceX[forceIndex(base + ivec2(1, 1))].x,
        forceY[forceIndex(base + ivec2(1, 1))].x
    );
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

vec2 accelerationAt(vec2 position) {
    if (uMutualGravity == 0) return uFieldAcceleration;
    vec2 result = interpolateForce(position) + uFieldAcceleration;
    ivec2 home = ivec2(floor(
        position * vec2(uPhysicalWidth, uPhysicalHeight)
    ));
    for (int dy = -uNeighborRadiusY; dy <= uNeighborRadiusY; ++dy) {
        for (int dx = -uNeighborRadiusX; dx <= uNeighborRadiusX; ++dx) {
            ivec2 neighborCell = home + ivec2(dx, dy);
            // Walls: there is nothing beyond an edge to attract.
            if (uBounded != 0 && (any(lessThan(neighborCell, ivec2(0))) ||
                any(greaterThanEqual(neighborCell, ivec2(uPhysicalWidth, uPhysicalHeight))))) continue;
            int index = cellIndex(neighborCell);
            int count = cellCounts[index];
            bool homeCell = dx == 0 && dy == 0;
            if (!homeCell && count > uExactCellThreshold) {
                vec2 center = (vec2(wrapCell(neighborCell)) + 0.5) /
                    vec2(uPhysicalWidth, uPhysicalHeight);
                // Unit masses: the count is the exact aggregate mass.
                float aggregateMass = float(count);
                result += localAcceleration(
                    center,
                    position,
                    aggregateMass
                );
            } else {
                int other = heads[index];
                int visited = 0;
                int limit =
                    homeCell
                        ? uMaximumHomeInteractions
                        : uExactCellThreshold;
                while (other >= 0 && visited < limit) {
                    result += localAcceleration(
                        bodies[other].xy,
                        position,
                        1.0
                    );
                    other = nextBody[other];
                    visited++;
                }
            }
        }
    }
    return result;
}

float integrationDt(vec2 velocity, vec2 acceleration) {
    float speedPixels = length(velocity * uViewport);
    float accelerationPixels = length(acceleration * uViewport);
    float result;
    if (accelerationPixels > 1e-5) {
        result = (
            sqrt(
                speedPixels * speedPixels +
                2.0 * accelerationPixels * uTargetSegmentPixels
            ) - speedPixels
        ) / accelerationPixels;
    } else {
        result = uTargetSegmentPixels / max(speedPixels, 1e-5);
    }
    return clamp(result, uMinimumDt, uMaximumDt);
}

void emitPeriodicStep(
    int step,
    vec2 start,
    vec2 delta,
    float startDistance,
    float stepDistance,
    float startDashCoordinate,
    float stepDashCoordinate
) {
    int baseVertex = step * VERTICES_PER_STEP;
    for (int vertex = 0; vertex < VERTICES_PER_STEP; ++vertex) {
        trajectory[baseVertex + vertex] = vec4(0.0, 0.0, 0.0, -1.0);
    }

    vec2 end = start + delta;
    float cuts[4];
    int cutCount = 2;
    cuts[0] = 0.0;
    cuts[1] = 1.0;
    if (end.x < 0.0) {
        cuts[cutCount++] = -start.x / delta.x;
    } else if (end.x >= 1.0) {
        cuts[cutCount++] = (1.0 - start.x) / delta.x;
    }
    if (end.y < 0.0) {
        cuts[cutCount++] = -start.y / delta.y;
    } else if (end.y >= 1.0) {
        cuts[cutCount++] = (1.0 - start.y) / delta.y;
    }

    for (int index = 1; index < cutCount; ++index) {
        float value = clamp(cuts[index], 0.0, 1.0);
        int insertion = index;
        while (insertion > 0 && cuts[insertion - 1] > value) {
            cuts[insertion] = cuts[insertion - 1];
            insertion--;
        }
        cuts[insertion] = value;
    }

    float uniqueCuts[4];
    int uniqueCount = 0;
    for (int index = 0; index < cutCount; ++index) {
        if (uniqueCount == 0 ||
            abs(cuts[index] - uniqueCuts[uniqueCount - 1]) > 1e-6) {
            uniqueCuts[uniqueCount++] = cuts[index];
        }
    }

    for (int piece = 0; piece < uniqueCount - 1; ++piece) {
        float firstFraction = uniqueCuts[piece];
        float secondFraction = uniqueCuts[piece + 1];
        float middleFraction = 0.5 * (firstFraction + secondFraction);
        vec2 tile = floor(start + delta * middleFraction);
        vec2 first = start + delta * firstFraction - tile;
        vec2 second = start + delta * secondFraction - tile;
        int vertex = baseVertex + piece * 2;
        trajectory[vertex] = vec4(
            clamp(first, vec2(0.0), vec2(1.0)),
            startDashCoordinate + stepDashCoordinate * firstFraction,
            startDistance + stepDistance * firstFraction
        );
        trajectory[vertex + 1] = vec4(
            clamp(second, vec2(0.0), vec2(1.0)),
            startDashCoordinate + stepDashCoordinate * secondFraction,
            startDistance + stepDistance * secondFraction
        );
    }
}

void main() {
    vec2 position = uOriginPixels / uViewport;
    vec2 velocity = uVelocityPixels / uViewport;
    vec2 acceleration = accelerationAt(position);
    float pathDistancePixels = 0.0;
    float dashCoordinatePixels = 0.0;
    bool finished = false;

    for (int step = 0; step < uStepCount; ++step) {
        if (finished) {
            int baseVertex = step * VERTICES_PER_STEP;
            for (int vertex = 0; vertex < VERTICES_PER_STEP; ++vertex) {
                trajectory[baseVertex + vertex] =
                    vec4(0.0, 0.0, 0.0, -1.0);
            }
            continue;
        }

        float dt = integrationDt(velocity, acceleration);
        vec2 halfStepVelocity = velocity + acceleration * (0.5 * dt);
        vec2 delta = halfStepVelocity * dt;
        if (uBounded != 0) {
            // Walls act like body contacts: the normal motion stops, and
            // rebounds by the restitution coefficient.
            vec2 next = position + delta;
            vec2 clamped = clamp(next, vec2(0.0), vec2(MAXIMUM_UNIT));
            bvec2 hit = notEqual(next, clamped);
            halfStepVelocity = mix(
                halfStepVelocity,
                -uRestitutionCoefficient * halfStepVelocity,
                vec2(hit)
            );
            delta = clamped - position;
        }
        float stepDistancePixels = length(delta * uViewport);
        float remainingDistancePixels =
            uMaximumPathPixels - pathDistancePixels;
        if (stepDistancePixels > remainingDistancePixels) {
            delta *= remainingDistancePixels / stepDistancePixels;
            stepDistancePixels = remainingDistancePixels;
            finished = true;
        }
        float speedMultiplier = 1.0 + length(halfStepVelocity);
        float dashLengthPixels =
            uMinimumDashPixels * speedMultiplier;
        float stepDashCoordinatePixels =
            stepDistancePixels * uMinimumDashPixels / dashLengthPixels;
        emitPeriodicStep(
            step,
            position,
            delta,
            pathDistancePixels,
            stepDistancePixels,
            dashCoordinatePixels,
            stepDashCoordinatePixels
        );
        pathDistancePixels += stepDistancePixels;
        dashCoordinatePixels += stepDashCoordinatePixels;
        position = uBounded != 0 ? position + delta : fract(position + delta);
        if (pathDistancePixels >= uMaximumPathPixels - 1e-4) {
            finished = true;
            continue;
        }

        acceleration = accelerationAt(position);
        velocity = halfStepVelocity + acceleration * (0.5 * dt);
    }

    float inversePathLength = 1.0 / max(pathDistancePixels, 1e-6);
    int vertexCount = uStepCount * VERTICES_PER_STEP;
    for (int vertex = 0; vertex < vertexCount; ++vertex) {
        if (trajectory[vertex].w >= 0.0) {
            trajectory[vertex].w =
                clamp(trajectory[vertex].w * inversePathLength, 0.0, 1.0);
        }
    }
}
