#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer CollisionHeads { int collisionHeads[]; };
layout(std430, binding = 2) buffer NextBody { int nextBody[]; };
layout(std430, binding = 3) buffer CollisionCellCounts { int collisionCellCounts[]; };

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    ivec2 cell = clamp(
        ivec2(floor(bodies[id].xy * vec2(uGridWidth, uGridHeight))),
        ivec2(0),
        ivec2(uGridWidth - 1, uGridHeight - 1)
    );
    int index = cell.x + cell.y * uGridWidth;
    nextBody[id] = atomicExchange(collisionHeads[index], int(id));
    atomicAdd(collisionCellCounts[index], 1);
}
