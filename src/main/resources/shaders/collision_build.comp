#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer Heads { uint heads[]; };
layout(std430, binding = 2) writeonly buffer CollisionNext { uint collisionNext[]; };
layout(std430, binding = 3) readonly buffer Accelerations { vec2 acceleration[]; };
layout(std430, binding = 4) readonly buffer AdaptiveState { uint adaptiveState[]; };

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform float uKickDt;
uniform float uDriftDt;
uniform float uTimeStep;
uniform int uAdaptive;
uniform int uSubstepIndex;
uniform int uBounded;

// Largest float below 1: a body clamped to a wall stays in the last grid cell.
const float MAXIMUM_UNIT = 0.99999994;

ivec2 wrapCell(ivec2 cell) {
    if (cell.x < 0) cell.x += uGridWidth;
    else if (cell.x >= uGridWidth) cell.x -= uGridWidth;
    if (cell.y < 0) cell.y += uGridHeight;
    else if (cell.y >= uGridHeight) cell.y -= uGridHeight;
    return cell;
}

void main() {
    if (
        uAdaptive != 0 &&
        uSubstepIndex >= 0 &&
        uint(uSubstepIndex) >= adaptiveState[2]
    ) return;
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    vec4 body = bodies[id];
    float driftDt = uAdaptive != 0 && uDriftDt != 0.0
        ? uTimeStep / float(max(adaptiveState[2], 1u))
        : uDriftDt;
    if (uKickDt != 0.0 || driftDt != 0.0) {
        body.zw += acceleration[id] * (0.5 * uKickDt);
        body.xy += body.zw * driftDt;
        body.xy = uBounded != 0
            ? clamp(body.xy, vec2(0.0), vec2(MAXIMUM_UNIT))
            : fract(body.xy);
        bodies[id] = body;
    }

    ivec2 cell = ivec2(floor(
        body.xy * vec2(uGridWidth, uGridHeight)
    ));
    cell = wrapCell(cell);
    uint index = uint(cell.x + cell.y * uGridWidth);

    // Zero is the empty-list marker; particle ids are stored one-based.
    collisionNext[id] = atomicExchange(heads[index], id + 1u);
}
