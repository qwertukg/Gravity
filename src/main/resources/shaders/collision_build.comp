#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer Heads { uint heads[]; };
layout(std430, binding = 2) writeonly buffer CollisionNext { uint collisionNext[]; };

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform vec2 uViewport;
uniform float uCellSizePixels;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    vec2 positionPixels = bodies[id].xy * uViewport;
    ivec2 cell = ivec2(floor(positionPixels / uCellSizePixels));
    cell = clamp(cell, ivec2(0), ivec2(uGridWidth - 1, uGridHeight - 1));
    uint index = uint(cell.x + cell.y * uGridWidth);

    // Zero is the empty-list marker; particle ids are stored one-based.
    collisionNext[id] = atomicExchange(heads[index], id + 1u);
}
