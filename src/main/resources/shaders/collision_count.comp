#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) readonly buffer Heads { uint heads[]; };
layout(std430, binding = 2) readonly buffer CollisionNext { uint collisionNext[]; };
layout(std430, binding = 3) buffer ContactCounts { uint contactCounts[]; };
layout(std430, binding = 4) readonly buffer AdaptiveState { uint adaptiveState[]; };

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform vec2 uViewport;
uniform float uDiameterPixels;
uniform int uNeighborCellRadius;
uniform int uAdaptive;
uniform int uSubstepIndex;
uniform int uBounded;
#include "collision_material.glsl"
#ifdef RIGID
#include "collision_rigid.glsl"

void countGroupContacts(uint id, uint contacts) {
    int group = groupOf(id);
    if (group >= 0) atomicAdd(groups[group].grid.w, int(contacts));
}
#endif

ivec2 wrapCell(ivec2 cell) {
    if (cell.x < 0) cell.x += uGridWidth;
    else if (cell.x >= uGridWidth) cell.x -= uGridWidth;
    if (cell.y < 0) cell.y += uGridHeight;
    else if (cell.y >= uGridHeight) cell.y -= uGridHeight;
    return cell;
}

void main() {
    if (
        uAdaptive != 0 &&
        uSubstepIndex >= 0 &&
        uint(uSubstepIndex) >= adaptiveState[2]
    ) return;
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    vec2 positionPixels = bodies[id].xy * uViewport;
    ivec2 home = ivec2(floor(
        bodies[id].xy * vec2(uGridWidth, uGridHeight)
    ));
    float diameterSquared = uDiameterPixels * uDiameterPixels;
#ifdef RIGID
    countGroupContacts(id, wallTouches(positionPixels));
#endif
    for (int dy = -uNeighborCellRadius; dy <= uNeighborCellRadius; ++dy) {
        for (int dx = -uNeighborCellRadius; dx <= uNeighborCellRadius; ++dx) {
            ivec2 cell = wrapCell(home + ivec2(dx, dy));

            uint encoded = heads[cell.x + cell.y * uGridWidth];
            while (encoded != 0u) {
                uint otherId = encoded - 1u;
                if (otherId > id && hardPair(id, otherId)) {
                    // The solver and cached counter must agree at the strict
                    // cutoff; prevent context-dependent FMA contraction here.
                    precise vec2 delta =
                        positionPixels - bodies[otherId].xy * uViewport;
                    // Walls: no minimum image, bodies across an edge never touch.
                    if (uBounded == 0) delta -= floor(delta / uViewport + vec2(0.5)) * uViewport;
                    precise float distanceSquared = dot(delta, delta);
                    if (distanceSquared < contactReachSquared(id, otherId)) {
                        atomicAdd(contactCounts[id], 1u);
                        atomicAdd(contactCounts[otherId], 1u);
#ifdef RIGID
                        countGroupContacts(id, 1u);
                        countGroupContacts(otherId, 1u);
#endif
                    }
                }
                encoded = collisionNext[otherId];
            }
        }
    }
}
