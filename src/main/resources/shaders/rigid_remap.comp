#version 430 core
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Members { int members[]; };
layout(std430, binding = 1) readonly buffer Destinations { uint destinations[]; };
uniform int uCount;

// Spatial sorting renamed the bodies; members follow them to their new IDs.
void main() {
    uint member = gl_GlobalInvocationID.x;
    if (member >= uint(uCount)) return;
    int body = members[member];
    if (body >= 0) members[member] = int(destinations[body]);
}
