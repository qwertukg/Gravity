#version 430 core
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Positions { vec2 positions[]; };
layout(std430, binding = 1) buffer Heads { int heads[]; };
layout(std430, binding = 2) writeonly buffer Next { int next[]; };
layout(std430, binding = 6) readonly buffer Bodies { vec4 bodies[]; };
uniform int uCount;
#include "liquid_kernel.glsl"

// Heads are cleared to -1 beforehand; every body pushes itself onto its cell.
// Positions get their own compact copy, which is all the passes read of a
// neighbour, and the first lambda pass builds the lists.
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id == 0u) lists[flagOffset(0)] = 1u;
    if (id >= uint(uCount)) return;
    vec2 position = bodies[id].xy;
    positions[id] = position;
    int cell = liquidCellIndex(liquidCell(position));
    lists[listOffset(PLANE_CELL, id)] = uint(cell);
    next[id] = atomicExchange(heads[cell], int(id));
}
