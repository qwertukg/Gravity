#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Density { uint density[]; };
layout(std430, binding = 1) writeonly buffer OutputComplex { vec2 outputComplex[]; };

uniform int uGrid;
uniform int uBits;
uniform float uInverseMassScale;

uint reverseBits(uint value, int bits) {
    return bitfieldReverse(value) >> (32 - bits);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint cells = uint(uGrid * uGrid);
    if (id >= cells) return;
    uint x = id % uint(uGrid);
    uint y = id / uint(uGrid);
    uint source = reverseBits(x, uBits) + y * uint(uGrid);
    outputComplex[id] = vec2(float(density[source]) * uInverseMassScale, 0.0);
}
