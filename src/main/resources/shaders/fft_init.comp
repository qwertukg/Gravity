#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Density { uint density[]; };
layout(std430, binding = 1) writeonly buffer OutputComplex { vec2 outputComplex[]; };

uniform int uGridWidth;
uniform int uGridHeight;
uniform float uInverseMassScale;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint width = uint(uGridWidth);
    uint cells = width * uint(uGridHeight);
    if (id >= cells) return;
    outputComplex[id] = vec2(float(density[id]) * uInverseMassScale, 0.0);
}
