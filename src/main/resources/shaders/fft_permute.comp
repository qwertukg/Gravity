#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer InputComplex { vec2 inputComplex[]; };
layout(std430, binding = 1) writeonly buffer OutputComplex { vec2 outputComplex[]; };

uniform int uGridWidth;
uniform int uGridHeight;
uniform int uBits;
uniform int uAxis;

uint reverseBits(uint value, int bits) {
    return bitfieldReverse(value) >> (32 - bits);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint width = uint(uGridWidth);
    uint height = uint(uGridHeight);
    if (id >= width * height) return;
    uint x = id % width;
    uint y = id / width;
    uint source = uAxis == 0
        ? reverseBits(x, uBits) + y * width
        : x + reverseBits(y, uBits) * width;
    outputComplex[id] = inputComplex[source];
}
