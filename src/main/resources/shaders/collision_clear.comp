#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer CollisionHeads { int collisionHeads[]; };
layout(std430, binding = 1) buffer CollisionDeltas { ivec4 collisionDeltas[]; };

uniform int uCells;
uniform int uCount;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id < uint(uCells)) collisionHeads[id] = -1;
    if (id < uint(uCount)) collisionDeltas[id] = ivec4(0);
}
