#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer PreviousBodies { vec4 previousBodies[]; };
layout(std430, binding = 1) buffer Heads { uint heads[]; };
layout(std430, binding = 2) writeonly buffer ContactCounts { uint contactCounts[]; };
layout(std430, binding = 3) readonly buffer AdaptiveState { uint adaptiveState[]; };
#include "rigid_layout.glsl"
layout(std430, binding = 9) buffer Rigid { RigidGroup groups[MAXIMUM_GROUPS]; };
uniform int uRigidGroups;
uniform float uDriftDt;
uniform float uTimeStep;

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform int uAdaptive;
uniform int uSubstepIndex;

ivec2 wrapCell(ivec2 cell) {
    if (cell.x < 0) cell.x += uGridWidth;
    else if (cell.x >= uGridWidth) cell.x -= uGridWidth;
    if (cell.y < 0) cell.y += uGridHeight;
    else if (cell.y >= uGridHeight) cell.y -= uGridHeight;
    return cell;
}

void main() {
    if (
        uAdaptive != 0 &&
        uSubstepIndex >= 0 &&
        uint(uSubstepIndex) >= adaptiveState[2]
    ) return;
    uint id = gl_GlobalInvocationID.x;
    // The count pass adds up the contacts of every block afresh.
    if (id < uint(uRigidGroups)) {
        groups[id].grid.w = 0;
        // The pose the solve meets every block in (collision_rigid.glsl).
        float poseDt = uAdaptive != 0 && uDriftDt != 0.0 ? uTimeStep / float(max(adaptiveState[2], 1u)) : uDriftDt;
        groups[id].pose = rigidPose(groups[id], poseDt);
    }
    if (id >= uint(uCount)) return;
    contactCounts[id] = 0u;

    ivec2 cell = ivec2(floor(
        previousBodies[id].xy * vec2(uGridWidth, uGridHeight)
    ));
    cell = wrapCell(cell);
    uint index = uint(cell.x + cell.y * uGridWidth);

    // Several particles may clear the same cell. The atomic makes those
    // identical writes well-defined without scanning the mostly empty grid.
    atomicExchange(heads[index], 0u);
}
