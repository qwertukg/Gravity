#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer PreviousBodies { vec4 previousBodies[]; };
layout(std430, binding = 1) buffer Heads { uint heads[]; };

uniform int uCount;
uniform int uGridWidth;
uniform int uGridHeight;
uniform vec2 uViewport;
uniform float uCellSizePixels;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;

    vec2 positionPixels = previousBodies[id].xy * uViewport;
    ivec2 cell = ivec2(floor(positionPixels / uCellSizePixels));
    cell = clamp(cell, ivec2(0), ivec2(uGridWidth - 1, uGridHeight - 1));
    uint index = uint(cell.x + cell.y * uGridWidth);

    // Several particles may clear the same cell. The atomic makes those
    // identical writes well-defined without scanning the mostly empty grid.
    atomicExchange(heads[index], 0u);
}
