#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Bodies { vec4 bodies[]; };
layout(std430, binding = 1) buffer Density { uint density[]; };
layout(std430, binding = 2) buffer Heads { int heads[]; };
layout(std430, binding = 3) buffer NextBody { int nextBody[]; };
layout(std430, binding = 4) readonly buffer Masses { float masses[]; };
layout(std430, binding = 5) buffer CellCounts { int cellCounts[]; };
layout(std430, binding = 6) buffer CellMass { uint cellMass[]; };
layout(std430, binding = 7) readonly buffer ActiveFlags { int activeFlags[]; };

uniform int uCount;
uniform int uMeshWidth;
uniform int uPhysicalWidth;
uniform int uPhysicalHeight;
uniform int uMassScale;
uniform int uPointMassActive;
uniform vec2 uPointMassPosition;
uniform float uPointMass;

uint densityIndex(ivec2 physicalCell) {
    ivec2 offset = ivec2(uPhysicalWidth / 2, uPhysicalHeight / 2);
    ivec2 meshCell = physicalCell + offset;
    return uint(meshCell.x + meshCell.y * uMeshWidth);
}

uint cellIndex(ivec2 cell) {
    return uint(cell.x + cell.y * uPhysicalWidth);
}

void depositDensity(vec2 position, float mass) {
    vec2 gridPosition = position * vec2(uPhysicalWidth, uPhysicalHeight) - 0.5;
    ivec2 base = ivec2(floor(gridPosition));
    vec2 fraction = fract(gridPosition);
    vec4 weights = vec4(
        (1.0 - fraction.x) * (1.0 - fraction.y),
        fraction.x * (1.0 - fraction.y),
        (1.0 - fraction.x) * fraction.y,
        fraction.x * fraction.y
    );
    float scale = float(uMassScale) * mass;
    atomicAdd(density[densityIndex(base)], uint(round(weights.x * scale)));
    atomicAdd(density[densityIndex(base + ivec2(1, 0))], uint(round(weights.y * scale)));
    atomicAdd(density[densityIndex(base + ivec2(0, 1))], uint(round(weights.z * scale)));
    atomicAdd(density[densityIndex(base + ivec2(1, 1))], uint(round(weights.w * scale)));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uCount)) return;
    if (id == 0u && uPointMassActive != 0) {
        depositDensity(uPointMassPosition, uPointMass);
    }
    if (activeFlags[id] == 0) return;

    vec2 p = bodies[id].xy;
    depositDensity(p, masses[id]);

    ivec2 home = ivec2(floor(p * vec2(uPhysicalWidth, uPhysicalHeight)));
    uint homeIndex = cellIndex(home);
    nextBody[id] = atomicExchange(heads[homeIndex], int(id));
    atomicAdd(cellCounts[homeIndex], 1);
    atomicAdd(cellMass[homeIndex], uint(round(masses[id] * float(uMassScale))));
}
